{
  "name": "smd-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "astro check",
    "typecheck:workers": "for dir in workers/*/; do [ -f \"${dir}package.json\" ] || continue; echo \"Typechecking $dir\" && npm run typecheck --prefix \"$dir\" || exit 1; done",
    "test:workers": "for dir in workers/*/; do [ -f \"${dir}package.json\" ] || continue; echo \"Testing $dir\" && npm run test --prefix \"$dir\" || exit 1; done",
    "verify": "npm run typecheck && npm run typecheck:workers && npm run format:check && npm run lint && npm run build && npm run test && npm run test:workers",
    "handbook:drift": "node scripts/handbook-drift.mjs",
    "db:migrate:local": "wrangler d1 migrations apply ss-console-db --local",
    "prepare": "node -e \"if(process.env.CI)process.exit(0)\" && husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.10",
    "@astrojs/sitemap": "^3.7.3",
    "@clerk/astro": "^3.4.7",
    "@elevenlabs/client": "^1.12.1",
    "@formepdf/core": "^0.10.4",
    "@formepdf/react": "^0.10.4",
    "@sentry/cloudflare": "^10.60.0",
    "@venturecrane/tokens": "0.0.2-alpha.0",
    "astro": "^6.3.5",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "ics": "^3.12.0",
    "jose": "^6.2.3",
    "react": "^19.2.7",
    "wrangler": "^4.104.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@cloudflare/workers-types": "^4.20260417.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@venturecrane/crane-test-harness": "^0.1.0",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-import-x": "^4.17.0",
    "globals": "^17.7.0",
    "husky": "^9.1.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "defu": "^6.1.7",
    "undici": "^7.24.4",
    "js-cookie": "^3.0.7",
    "esbuild": "0.28.1",
    "ws": "8.21.0",
    "yaml": "2.8.3"
  }
}
