---
import { GOOGLE_FONTS_URL } from '../lib/fonts'
import '../styles/global.css'
import SkipToMain from '../components/SkipToMain.astro'
import SmdLogo from '../components/SmdLogo.astro'
import AdminNav from '../components/admin/AdminNav.astro'
import { buildAdminNav } from '../lib/admin/nav'
import { SignOutButton } from '@clerk/astro/components'

interface BreadcrumbItem {
  label: string
  href?: string
}

interface Props {
  title: string
  breadcrumbs?: BreadcrumbItem[]
  maxWidth?: 'max-w-5xl' | 'max-w-6xl'
  mainClass?: string
}

const { title, breadcrumbs = [], maxWidth = 'max-w-5xl', mainClass = '' } = Astro.props
const session = Astro.locals.session!
const pathname = Astro.url.pathname

// Five-destination spine (ADR 0077): the admin console mirrors the client
// portal — same object graph, guide's side. Nav is a dedicated band below the
// header (AdminNav), not crammed into the header row; the ADMIN badge is gone;
// Settings is an account affordance here in the header, not a spine word.
const destinations = buildAdminNav()

const iconClasses =
  'inline-flex items-center justify-center w-11 h-11 rounded-[var(--ss-radius-button)] text-[color:var(--ss-color-text-secondary)] hover:text-[color:var(--ss-color-primary)] active:text-[color:var(--ss-color-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2'
const settingsActive = pathname.startsWith('/admin/settings')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href={GOOGLE_FONTS_URL} rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body
    class="min-h-screen bg-[color:var(--ss-color-background)] text-[color:var(--ss-color-text-primary)]"
  >
    <SkipToMain />
    <header
      role="banner"
      class="sticky top-0 z-50 h-14 md:h-16 bg-[color:var(--ss-color-background)] border-b-[3px] border-[color:var(--ss-color-text-primary)]"
    >
      <div
        class={`${maxWidth} mx-auto h-full px-4 md:px-6 flex items-center justify-between gap-3`}
      >
        <div class="flex items-baseline gap-3 md:gap-4 min-w-0">
          <SmdLogo href="/admin" />
          <span
            class="hidden sm:block font-mono text-xs font-semibold uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)] truncate"
          >
            {session.email}
          </span>
        </div>

        <div class="flex items-center gap-1">
          <a
            href="/admin/settings"
            aria-label="Settings"
            title="Settings"
            aria-current={settingsActive ? 'page' : undefined}
            class:list={[iconClasses, settingsActive ? 'text-[color:var(--ss-color-primary)]' : '']}
          >
            <span class="material-symbols-outlined" aria-hidden="true">settings</span>
          </a>
          <SignOutButton asChild redirectUrl="/auth/sign-in?status=signed_out">
            <button type="button" aria-label="Sign out" title="Sign out" class={iconClasses}>
              <span class="material-symbols-outlined" aria-hidden="true">logout</span>
            </button>
          </SignOutButton>
        </div>
      </div>
    </header>

    <AdminNav destinations={destinations} pathname={pathname} maxWidth={maxWidth} />

    <main id="main" role="main" class={`${maxWidth} mx-auto px-4 py-8 pb-24 md:pb-8 ${mainClass}`}>
      {
        breadcrumbs.length > 0 && (
          <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="flex flex-wrap items-center gap-1 text-sm text-[color:var(--ss-color-text-secondary)]">
              {breadcrumbs.map((crumb, i) => (
                <>
                  {i > 0 && (
                    <li aria-hidden="true" class="flex items-center">
                      <span class="material-symbols-outlined text-base text-[color:var(--ss-color-text-muted)]">
                        chevron_right
                      </span>
                    </li>
                  )}
                  <li class="max-w-[24ch] md:max-w-none truncate">
                    {crumb.href ? (
                      <a
                        href={crumb.href}
                        class="hover:text-[color:var(--ss-color-primary)] active:text-[color:var(--ss-color-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 rounded transition-colors"
                      >
                        {crumb.label}
                      </a>
                    ) : (
                      <span
                        aria-current="page"
                        class="text-[color:var(--ss-color-text-primary)] font-medium"
                      >
                        {crumb.label}
                      </span>
                    )}
                  </li>
                </>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
    </main>
  </body>
</html>
