---
/**
 * "What [persona] used to write this" — draft sourcing block (#807).
 *
 * Renders the source attribution surface on the draft detail page. The
 * block lists every source the skill consumed when authoring the
 * draft: matter documents, memory rules, voice samples, system-of-
 * record reads, verbatim quotes. The reviewer can verify that the
 * draft came from authorized data before approving the send.
 *
 * Per UX Lead synthesis Theme 21 (PRD §12), this is a critical trust-
 * building element: "I'm not trying to break the product, I'm trying
 * to trust it." The block is also the partner-facing entry point into
 * the compliance evidence packet — the audit log persists what each
 * draft touched, the sourcing block surfaces it on the read path.
 *
 * Behavior:
 *   - Empty `sources[]`            → renders the empty-state prose per
 *                                    docs/style/empty-state-pattern.md
 *                                    ("No sources cited yet"). NEVER a
 *                                    fabricated list.
 *   - 1–N sources, N ≤ threshold   → fully expanded by default.
 *   - More than threshold sources  → collapsed by default with an
 *                                    expand affordance (native <details>
 *                                    + <summary>). The threshold lives
 *                                    in `drafts.ts` as
 *                                    `SOURCE_BLOCK_COLLAPSE_THRESHOLD`.
 *   - Sources grouped by kind      → matter documents first, verbatim
 *                                    quotes last, per SOURCE_KINDS
 *                                    declaration order. Stable across
 *                                    drafts.
 *
 * Persona name handling:
 *   The block title incorporates the active persona's display name per
 *   ADR 0011 (`personaName` prop, read from `getActivePersona` at the
 *   page level). When no persona is configured the title falls back to
 *   the generic "your AI Employee" — never a hardcoded fixture name
 *   (no "Marcus" in shipped user-facing copy). The internal persona
 *   string from the draft itself is NOT used here; that's the audit-
 *   trail preamble, not the customer-facing label.
 *
 * Composition contract:
 *   This block is composed by the page (`drafts/[id].astro`), not by
 *   DraftDetail.astro. The composition site is the page so that
 *   DraftDetail (from PR #960) stays untouched per the issue's strict
 *   file-scope rule.
 *
 * Anti-fabrication:
 *   Per CLAUDE.md (Pattern A/B) and docs/style/empty-state-pattern.md,
 *   this component never invents source rows. The resolver returns
 *   `sources: []` until the Hermes bridge for source attribution
 *   lands (#821 follow-on). The empty-state prose is the contract for
 *   that interval — not a placeholder list of plausible-looking
 *   sources.
 */

import {
  SOURCE_BLOCK_COLLAPSE_THRESHOLD,
  groupSourcesByKind,
  type SourceItem,
} from '../../../lib/portal/ai-employee/drafts'
import SourceItemComponent from './SourceItem.astro'

interface Props {
  sources: SourceItem[]
  /**
   * Display name of the customer's active AI Employee persona, read
   * from `getActivePersona` at the page level. When null (no active
   * persona configured), the block uses the generic
   * "your AI Employee" label. Never accept a hardcoded fixture name
   * — that would violate the no-fabrication policy.
   */
  personaName: string | null
}

const { sources, personaName } = Astro.props

const trustedPersonaLabel = personaName && personaName.length > 0 ? personaName : 'your AI Employee'

const blockTitle = `What ${trustedPersonaLabel} used to write this`

const totalCount = sources.length
const groups = groupSourcesByKind(sources)
const startsCollapsed = totalCount > SOURCE_BLOCK_COLLAPSE_THRESHOLD
---

<section
  aria-label="Draft sources"
  class="border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-surface)]"
>
  <header
    class="flex flex-wrap items-baseline justify-between gap-3 px-5 md:px-6 py-3 md:py-4 border-b-[2px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-primary)]"
  >
    <h2 class="font-['Archivo'] font-bold text-base md:text-lg uppercase tracking-[0.04em] m-0">
      {blockTitle}
    </h2>
    <span class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-semibold">
      {totalCount === 0 ? 'No sources' : totalCount === 1 ? '1 source' : `${totalCount} sources`}
    </span>
  </header>

  <div class="px-5 md:px-6 py-5 md:py-6">
    {
      totalCount === 0 ? (
        <p class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)] m-0">
          No sources cited yet. Sources appear here once the AI Employee records what it consulted
          while writing this draft.
        </p>
      ) : startsCollapsed ? (
        <details class="group">
          <summary class="flex items-center gap-2 cursor-pointer list-none font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-semibold text-[color:var(--ss-color-text-primary)] hover:text-[color:var(--ss-color-action)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2">
            <span class="group-open:hidden">Show sources</span>
            <span class="hidden group-open:inline">Hide sources</span>
          </summary>
          <div class="mt-stack flex flex-col gap-stack">
            {groups.map((group) => (
              <ul class="flex flex-col gap-2 list-none m-0 p-0">
                {group.items.map((source) => (
                  <SourceItemComponent source={source} />
                ))}
              </ul>
            ))}
          </div>
        </details>
      ) : (
        <div class="flex flex-col gap-stack">
          {groups.map((group) => (
            <ul class="flex flex-col gap-2 list-none m-0 p-0">
              {group.items.map((source) => (
                <SourceItemComponent source={source} />
              ))}
            </ul>
          ))}
        </div>
      )
    }
  </div>
</section>
