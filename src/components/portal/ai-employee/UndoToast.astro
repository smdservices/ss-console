---
/**
 * UndoToast — the bottom-of-screen mobile-sticky undo affordance shown
 * during the send countdown.
 *
 * Today this is the visual primitive used inside `ApproveAndSendButton`.
 * It is exported as a separate component for two reasons:
 *
 *   1. The issue contract (#870) names UndoToast as a discrete component.
 *   2. Other future surfaces (memory-rule deletion, persona swap) will
 *      reuse the same undo pattern; isolating the markup here keeps that
 *      reuse cheap.
 *
 * The component renders the toast markup statically. Behavior (countdown,
 * Undo wiring) is owned by the consuming surface — UndoToast is a
 * presentational primitive, not a controller. This split mirrors how
 * StatusPill is presentational and the surface owns the resolver call.
 *
 * Accessibility: role="status" + aria-live="polite" so AT announces the
 * countdown without interrupting an existing screen-reader flow. The
 * Undo button is a real <button> with a ≥ 44px tap target.
 */

interface Props {
  /**
   * Initial countdown in seconds (rounded up from the undo window).
   * The consuming surface updates this value via the
   * `[data-undo-count]` selector as the timer ticks.
   */
  initialSeconds: number
  /**
   * Optional message override. Defaults to a single-line prompt that
   * names the count cleanly.
   */
  prompt?: string
}

const { initialSeconds, prompt } = Astro.props
const message = prompt ?? 'Sending. Tap Undo to cancel.'
---

<div
  data-undo-toast
  hidden
  role="status"
  aria-live="polite"
  class="md:m-6 md:rounded-none border-t-[3px] md:border-[3px] border-[color:var(--ss-color-attention)] bg-[color:var(--ss-color-attention)] text-white px-5 py-4 md:px-6 md:py-5 flex flex-col md:flex-row md:items-center gap-3"
>
  <p class="font-['Archivo'] font-bold flex-1">
    {message}{' '}
    <span class="ml-2">
      <span data-undo-count>{initialSeconds}</span>s
    </span>
  </p>
  <button
    type="button"
    data-action="undo-send"
    class="inline-flex items-center justify-center min-h-12 px-6 py-2 bg-white text-[color:var(--ss-color-attention)] font-['Archivo_Narrow'] text-base font-bold uppercase tracking-[0.14em] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
  >
    Undo
  </button>
</div>
