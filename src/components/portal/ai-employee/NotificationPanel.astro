---
/**
 * Notification panel — compact list of the most recent notifications,
 * suitable for the dropdown surface the bell icon will eventually
 * open. For this PR, the panel renders inline on the dedicated
 * /notifications page as the "in-summary" view above the filterable
 * list, so the panel composition is tested end-to-end without
 * depending on a client-side popover.
 *
 * Layout:
 *   - 3px ink frame matching DraftsListTable / AuditLogTable / the
 *     rest of the portal's list-table chrome.
 *   - Header row: caption + "Mark all read" form-button on the right
 *     when there are unread items. Hidden when no unread.
 *   - Body: at most `limit` rows rendered via NotificationRow in
 *     compact mode. Empty state per docs/style/empty-state-pattern.md.
 *   - Footer (only when totalCount > rows.length): "View all" link
 *     into the full list page so the panel doesn't pretend to be the
 *     complete view.
 *
 * The panel does NOT render its own header chip / page heading — the
 * consuming page owns the `<h*>` semantics. The panel's caption is a
 * non-heading label so the page can drop it into any nesting context
 * without violating UI-PATTERNS R4 (heading skip ban).
 */

import NotificationRow from './NotificationRow.astro'
import type { Notification } from '../../../lib/portal/ai-employee/notifications'

interface Props {
  /**
   * Notifications to show in the panel, in display order. The panel
   * does not sort or filter — that is the page's responsibility.
   */
  rows: readonly Notification[]
  /**
   * Total count across all pages, used by the footer to decide
   * whether to render the "View all" link.
   */
  totalCount: number
  /**
   * Total unread count — drives the "Mark all read" affordance
   * visibility. The panel never derives this from `rows` because
   * `rows` may be the filtered subset (e.g., "Unread only" toggle
   * off) while the badge always reflects total unread.
   */
  unreadCount: number
  /**
   * URL the mark-all-read form returns to (303 Location). Defaults
   * to the full notifications page.
   */
  returnTo?: string
  /**
   * Caption rendered above the row stack. Lets the consuming page
   * label the panel ("Recent notifications", "Latest activity")
   * without forcing a fixed string.
   */
  caption?: string
  /**
   * URL the "View all" footer link points at. Defaults to the
   * notifications list page.
   */
  viewAllHref?: string
}

const {
  rows,
  totalCount,
  unreadCount,
  returnTo = '/portal/products/ai-employee/notifications',
  caption = 'Recent notifications',
  viewAllHref = '/portal/products/ai-employee/notifications',
} = Astro.props

const hasOverflow = totalCount > rows.length
const showMarkAll = unreadCount > 0
---

<section aria-label={caption} class="border-[3px] border-[color:var(--ss-color-text-primary)]">
  <header
    class="flex items-center justify-between gap-3 px-5 py-3 border-b-[2px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-border-subtle)]"
  >
    <p
      class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-primary)]"
    >
      {caption}
    </p>
    {
      showMarkAll && (
        <form
          method="POST"
          action="/api/portal/ai-employee/notifications/mark-all-read"
          class="contents"
        >
          <input type="hidden" name="returnTo" value={returnTo} />
          <button
            type="submit"
            class="inline-flex items-center min-h-11 px-3 py-2 font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-primary)] hover:text-[color:var(--ss-color-action)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 transition-colors"
          >
            Mark all read
          </button>
        </form>
      )
    }
  </header>

  {
    rows.length === 0 ? (
      <div class="px-5 py-8 text-center">
        <p class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
          Nothing here yet
        </p>
      </div>
    ) : (
      <div>
        {rows.map((notification) => (
          <NotificationRow notification={notification} returnTo={returnTo} compact />
        ))}
      </div>
    )
  }

  {
    hasOverflow && (
      <footer class="px-5 py-3 border-t-[2px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-border-subtle)] flex items-center justify-end">
        <a
          href={viewAllHref}
          class="inline-flex items-center min-h-11 px-3 py-2 font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-primary)] hover:text-[color:var(--ss-color-action)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 transition-colors"
        >
          View all {totalCount}
        </a>
      </footer>
    )
  }
</section>
