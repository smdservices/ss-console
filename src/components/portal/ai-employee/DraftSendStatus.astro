---
/**
 * DraftSendStatus — a single status display pill for the send
 * lifecycle of an AI Employee draft (pending / sending / sent /
 * send_failed).
 *
 * Used inside DraftDetail's identity strip. Exported as its own
 * component because:
 *
 *   1. The issue contract (#870) names DraftSendStatus as a discrete
 *      primitive.
 *   2. The matters detail surface (and the draft list table once
 *      drafts ship a real lifecycle column) can reuse the same
 *      tone-to-label resolver without redefining the closed
 *      vocabulary.
 *
 * Wraps StatusPill rather than reinventing the markup — keeping the
 * portal's status-tag pattern consolidated per UI-PATTERNS R7. The
 * resolver lives next to the DraftSendStatus type in `drafts.ts`
 * (formatDraftSendStatus); the tone map lives here because tone is
 * a presentation decision, not a data shape.
 *
 * Per docs/style/UI-PATTERNS.md R1 (status display by context), the
 * pill carries the fact alone — no redundant adjacent prose.
 */

import StatusPill from '../StatusPill.astro'
import { formatDraftSendStatus, type DraftSendStatus } from '../../../lib/portal/ai-employee/drafts'
import type { Tone } from '../../../lib/portal/status'

interface Props {
  status: DraftSendStatus
  /**
   * `compact` (default) for table rows and tight strips. `base` for
   * detail headers where the send status is the primary signal.
   */
  size?: 'compact' | 'base'
}

const { status, size = 'compact' } = Astro.props

const SEND_TONE: Record<DraftSendStatus, Tone> = {
  pending: 'info',
  sending: 'warning',
  sent: 'success',
  send_failed: 'danger',
}

const tone = SEND_TONE[status]
const label = formatDraftSendStatus(status).toUpperCase()
---

<StatusPill tone={tone} label={label} size={size} />
