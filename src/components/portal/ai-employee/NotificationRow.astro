---
/**
 * One row in the AI Employee notifications list.
 *
 * Used by both the NotificationPanel (compact dropdown summary) and
 * the full /notifications page. Lives in its own file so the row's
 * cell vocabulary (type / when / summary / actor / actions) can be
 * tested and revised independently of the surrounding chrome.
 *
 * Plainspoken aesthetic matching DraftRow and AuditEntryRow (#869 /
 * #873): 2px ink divider between rows, file-style mono numerics for
 * the timestamp, Archivo Narrow uppercase labels for column captions.
 * The outer 3px ink frame is provided by the parent surface — this
 * component is borderless at the row level so consecutive rows stitch
 * cleanly.
 *
 * Why not PortalListItem? PortalListItem's variants are status (title
 * + money + meta caption) and document (icon + title + eyebrow).
 * Neither fits the notification row's vocabulary (type chip + summary
 * + actor + actions + unread dot). A new primitive is the honest
 * answer; bending PortalListItem to fit would distort both surfaces.
 * Same rationale as DraftRow / MatterRow / AuditEntryRow / CalendarItemRow.
 *
 * Each row carries a mark-as-read POST form. Submitting the form
 * lands at /api/portal/ai-employee/notifications/[id]/mark-read which
 * 303-redirects back to the current page so the read state is
 * reflected on next render. No client-side JavaScript — the entire
 * mark-as-read flow is HTML form submission.
 *
 * The `actionUrl` (when present) is a separate anchor — clicking it
 * navigates to the related surface (the draft, the calibration
 * page) without marking the notification read. The reviewer marks it
 * read explicitly via the "Mark read" button, OR uses "Mark all
 * read" from the page header. This separation keeps the two intents
 * distinct: "look at it" vs "dismiss it".
 */

import StatusPill from '../StatusPill.astro'
import {
  formatNotificationAge,
  formatNotificationType,
  notificationTone,
  type Notification,
} from '../../../lib/portal/ai-employee/notifications'

interface Props {
  notification: Notification
  /**
   * Short serial shown in the № cell. Defaults to the first two
   * uppercase characters of the id. The parent passes the row index
   * for stable visual rhythm even when ids change underneath.
   */
  serial?: string
  /**
   * URL the mark-read form returns to (303 Location). Defaults to the
   * full /notifications page. The dropdown panel passes its own
   * referer so the user lands back on the page they opened the panel
   * from.
   */
  returnTo?: string
  /**
   * Compact variant for the dropdown panel — omits the № cell, the
   * actor caption, and the action affordance. Default is the full row
   * used on the /notifications page.
   */
  compact?: boolean
}

const {
  notification,
  serial,
  returnTo = '/portal/products/ai-employee/notifications',
  compact = false,
} = Astro.props

const resolvedSerial = serial ?? notification.id.slice(0, 2).toUpperCase()
const typeLabel = formatNotificationType(notification.type).toUpperCase()
const typeToneValue = notificationTone(notification.type)
const ageLabel = formatNotificationAge(notification.ts)

const markReadAction = `/api/portal/ai-employee/notifications/${encodeURIComponent(notification.id)}/mark-read`
---

<article
  class={`group bg-[color:var(--ss-color-surface)] border-b-[2px] border-[color:var(--ss-color-text-primary)] last:border-b-0 ${notification.unread ? '' : 'opacity-70'}`}
  data-notification-id={notification.id}
  data-unread={notification.unread ? 'true' : 'false'}
>
  <div
    class={`md:grid md:items-stretch ${compact ? 'md:grid-cols-[auto_minmax(0,1fr)_auto_auto]' : 'md:grid-cols-[56px_auto_minmax(0,1fr)_auto_auto]'}`}
  >
    {/* № cell — full row only */}
    {
      !compact && (
        <div
          class="flex md:border-r-[2px] md:border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-primary)] items-center justify-center md:min-h-[88px] py-3 md:py-0 font-['Archivo'] font-black text-num-cell"
          aria-hidden="true"
        >
          № {resolvedSerial}
        </div>
      )
    }

    {/* Type chip + unread dot */}
    <div
      class="md:border-r-[2px] md:border-[color:var(--ss-color-text-primary)] px-5 py-3 md:py-4 flex items-center gap-2"
    >
      {
        notification.unread && (
          <span
            class="inline-block w-2 h-2 rounded-full bg-[color:var(--ss-color-action)]"
            aria-label="Unread"
          />
        )
      }
      <StatusPill tone={typeToneValue} label={typeLabel} />
    </div>

    {/* Summary + optional actor */}
    <div
      class="md:border-r-[2px] md:border-[color:var(--ss-color-text-primary)] px-5 py-3 md:py-4 flex flex-col justify-center gap-1 min-w-0"
    >
      <span
        class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-semibold text-[color:var(--ss-color-text-secondary)]"
      >
        What
      </span>
      <span
        class={`font-['Archivo'] ${notification.unread ? 'font-bold' : 'font-medium'} text-[color:var(--ss-color-text-primary)] break-words`}
      >
        {notification.summary}
      </span>
      {
        !compact && notification.actor && (
          <span class="font-mono text-xs text-[color:var(--ss-color-text-muted)] truncate">
            from {notification.actor}
          </span>
        )
      }
    </div>

    {/* When */}
    <div
      class="md:border-r-[2px] md:border-[color:var(--ss-color-text-primary)] px-5 py-3 md:py-4 flex flex-col justify-center gap-1 items-start md:items-end"
    >
      <span
        class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-semibold text-[color:var(--ss-color-text-secondary)]"
      >
        When
      </span>
      <time
        datetime={notification.ts}
        class="font-mono text-sm text-[color:var(--ss-color-text-primary)]"
      >
        {ageLabel}
      </time>
    </div>

    {/* Action cluster */}
    <div class="px-5 py-3 md:py-4 flex items-center justify-end gap-3">
      {
        notification.actionUrl && (
          <a
            href={notification.actionUrl}
            class="inline-flex items-center min-h-11 px-3 py-2 font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-primary)] hover:text-[color:var(--ss-color-action)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 transition-colors"
          >
            Open
          </a>
        )
      }
      {
        notification.unread ? (
          <form method="POST" action={markReadAction} class="contents">
            <input type="hidden" name="returnTo" value={returnTo} />
            <button
              type="submit"
              class="inline-flex items-center min-h-11 px-3 py-2 border-[2px] border-[color:var(--ss-color-text-primary)] font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-primary)] hover:bg-[color:var(--ss-color-border-subtle)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 transition-colors"
            >
              Mark read
            </button>
          </form>
        ) : (
          <span
            aria-label="Already read"
            class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-muted)]"
          >
            Read
          </span>
        )
      }
    </div>
  </div>
</article>
