---
/**
 * PersonaRow — single-persona row inside PersonaFields.
 *
 * Split out of PersonaFields.astro to keep each component's render
 * body under the 75-line ceiling enforced by eslint
 * `max-lines-per-function`. Identical UX to in-place inlining; the
 * file boundary is the only difference.
 */

import type {
  EditablePersona,
  EditablePersonaSkill,
} from '../../../../lib/portal/ai-employee/customer-yaml-editor'
import type { ValidationError } from '../../../../lib/ai-employee/customer-yaml'

interface Props {
  persona: EditablePersona
  index: number
  errors: ValidationError[]
}

const { persona, index, errors } = Astro.props
const prefix = `personas[${index}]`

const TONE_OPTIONS = [
  'warm-but-professional',
  'concise',
  'plainspoken',
  'analytical',
  'patient',
  'direct',
]

const TRUST_CEILINGS: EditablePersonaSkill['trust_ceiling'][] = [
  'autonomous',
  'draft_for_review',
  'refused',
]

const rowErrors = errors.filter((e) => e.path === prefix || e.path.startsWith(`${prefix}.`))
---

<div class="space-y-6">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <label class="block">
      <span
        class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]"
      >
        Slug
      </span>
      <input
        type="text"
        name={`${prefix}.slug`}
        value={persona.slug}
        readonly
        aria-readonly="true"
        class="mt-2 w-full px-4 py-2 border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-border-subtle)] text-[color:var(--ss-color-text-muted)]"
      />
      <span class="mt-1 inline-block text-xs text-[color:var(--ss-color-text-muted)]"
        >Captain-managed</span
      >
    </label>

    <label class="block">
      <span
        class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]"
      >
        Name
      </span>
      <input
        type="text"
        name={`${prefix}.name`}
        value={persona.name}
        required
        maxlength="50"
        class="mt-2 w-full px-4 py-2 border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-background)] text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
      />
    </label>

    <label class="block">
      <span
        class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]"
      >
        Title
      </span>
      <input
        type="text"
        name={`${prefix}.title`}
        value={persona.title ?? ''}
        maxlength="50"
        class="mt-2 w-full px-4 py-2 border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-background)] text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
      />
    </label>

    <label class="block">
      <span
        class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]"
      >
        Pronouns
      </span>
      <select
        name={`${prefix}.pronouns`}
        class="mt-2 w-full px-4 py-2 border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-background)] text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
      >
        <option value="" selected={persona.pronouns === null}>(default they/them)</option>
        <option value="they/them" selected={persona.pronouns === 'they/them'}>they/them</option>
        <option value="he/him" selected={persona.pronouns === 'he/him'}>he/him</option>
        <option value="she/her" selected={persona.pronouns === 'she/her'}>she/her</option>
      </select>
    </label>

    <label class="block">
      <span
        class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]"
      >
        Status
      </span>
      <select
        name={`${prefix}.status`}
        class="mt-2 w-full px-4 py-2 border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-background)] text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
      >
        <option value="active" selected={persona.status === 'active'}>active</option>
        <option value="archived" selected={persona.status === 'archived'}>archived</option>
      </select>
    </label>

    <label class="block">
      <span
        class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]"
      >
        AgentMail identity
      </span>
      <input
        type="text"
        name={`${prefix}.send_as.agentmail_identity`}
        value={persona.send_as?.agentmail_identity ?? ''}
        class="mt-2 w-full px-4 py-2 border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-background)] text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
      />
    </label>
  </div>

  <fieldset class="border-[3px] border-[color:var(--ss-color-text-primary)] p-4">
    <legend
      class="px-2 font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]"
    >
      Tone adjectives
    </legend>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mt-2">
      {
        TONE_OPTIONS.map((tone) => (
          <label class="inline-flex items-center gap-2 text-sm text-[color:var(--ss-color-text-primary)]">
            <input
              type="checkbox"
              name={`${prefix}.tone[]`}
              value={tone}
              checked={persona.tone.includes(tone)}
              class="border-[2px] border-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
            />
            {tone}
          </label>
        ))
      }
    </div>
    <p class="mt-3 text-xs text-[color:var(--ss-color-text-muted)]">
      3 to 5 adjectives recommended.
    </p>
  </fieldset>

  {
    persona.skills.length > 0 && (
      <fieldset class="border-[3px] border-[color:var(--ss-color-text-primary)] p-4">
        <legend class="px-2 font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]">
          Skill trust ceilings
        </legend>
        <p class="mt-2 mb-4 text-xs text-[color:var(--ss-color-text-muted)]">
          Editor cannot add or remove skills; Captain controls the catalog. Trust ceiling may not
          exceed the SKILL.md authored ceiling.
        </p>
        <div class="space-y-3">
          {persona.skills.map((skill, skillIdx) => (
            <div class="flex flex-col md:flex-row md:items-center gap-3">
              <span class="font-['JetBrains_Mono'] text-sm text-[color:var(--ss-color-text-primary)] flex-1">
                {skill.name}
              </span>
              <label class="inline-flex items-center gap-2 text-sm">
                <input
                  type="checkbox"
                  name={`${prefix}.skills[${skillIdx}].enabled`}
                  value="true"
                  checked={skill.enabled}
                  class="border-[2px] border-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
                />
                enabled
              </label>
              <input type="hidden" name={`${prefix}.skills[${skillIdx}].name`} value={skill.name} />
              <select
                name={`${prefix}.skills[${skillIdx}].trust_ceiling`}
                class="px-3 py-1.5 border-[2px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-background)] text-[color:var(--ss-color-text-primary)] text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
              >
                {TRUST_CEILINGS.map((tc) => (
                  <option value={tc} selected={skill.trust_ceiling === tc}>
                    {tc}
                  </option>
                ))}
              </select>
            </div>
          ))}
        </div>
      </fieldset>
    )
  }

  {
    rowErrors.map((err) => (
      <p class="text-sm text-[color:var(--ss-color-error)]">
        <span class="font-['JetBrains_Mono']">{err.path}</span>: {err.message}
      </p>
    ))
  }
</div>
