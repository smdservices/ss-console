---
/** Single-line text input in the portal control kit (UI-PATTERNS Rule 8). */
import { CONTROL_BASE } from './control-classes'

interface Props {
  name: string
  required?: boolean
  maxlength?: number
  value?: string
  placeholder?: string
}
const { name, required = false, maxlength, value, placeholder } = Astro.props
---

<input
  type="text"
  name={name}
  required={required}
  maxlength={maxlength}
  value={value}
  placeholder={placeholder}
  class={CONTROL_BASE}
/>
