---
/**
 * StatusDot — the calm-register inline status indicator (UI-PATTERNS Rule 8).
 *
 * A small tone-colored dot: the calm counterpart to StatusPill for status
 * shown inline next to a label (aliveness, health, connection state). It
 * consumes the same `Tone` vocabulary from status.ts so a tone change
 * propagates to both the pill and the dot at once.
 *
 * The dot is the visual affordance only — the caller renders the text label
 * beside it. Marked aria-hidden because the status word is already in the DOM.
 */
import type { Tone } from '../../lib/portal/status'

interface Props {
  tone: Tone
  class?: string
}

const { tone, class: klass = '' } = Astro.props

// Fill mirrors TONE_CLASS backgrounds in status.ts (dot = the tone's fill).
const DOT_CLASS: Record<Tone, string> = {
  info: 'bg-[color:var(--color-action)]',
  success: 'bg-[color:var(--color-complete)]',
  danger: 'bg-[color:var(--color-error)]',
  warning: 'bg-[color:var(--color-attention)]',
  neutral: 'bg-[color:var(--color-text-muted)]',
  outline: 'bg-[color:var(--color-border)]',
}
---

<span class={`inline-block h-2 w-2 rounded-full ${DOT_CLASS[tone]} ${klass}`} aria-hidden="true"
></span>
