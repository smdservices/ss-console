---
/**
 * Voice sample management section for the Operator settings page.
 *
 * Lists voice samples by metadata only (cohort, source, date,
 * status). Raw sample bodies are NEVER displayed: voice samples can
 * carry private email content, and the voice pipeline (PR #951)
 * intentionally surfaces structural diffs in the dashboard rather
 * than the original prose. The portal must mirror that contract.
 *
 * Add / Remove are present as the working contract. The Add path
 * accepts an upload and inserts a pending row (real ingestion runs
 * via the voice pipeline). The Remove path POSTs a delete intent.
 * Both endpoints are wired today; their downstream propagation is
 * subject to the pipeline read/write surfaces landing on the
 * Hermes Machine side.
 *
 * Empty state: when no samples exist (including before the voice
 * pipeline has populated the portal-bound projection), the section
 * renders the empty-state prose per
 * docs/style/empty-state-pattern.md.
 */

import type { VoiceSample } from '../../../lib/portal/operator/settings'
import { formatVoiceSampleStatus } from '../../../lib/portal/operator/settings'

interface Props {
  samples: VoiceSample[]
}

const { samples } = Astro.props

function formatAddedAt(iso: string): string {
  const d = new Date(iso)
  if (Number.isNaN(d.getTime())) return ''
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
}
---

<section aria-labelledby="settings-voice-heading" class="mt-section">
  <div class="flex items-baseline justify-between gap-4 flex-wrap">
    <h2
      id="settings-voice-heading"
      class="font-body text-xl md:text-2xl font-black uppercase tracking-[-0.01em] text-[color:var(--ss-color-text-primary)] m-0"
    >
      Voice samples
    </h2>
    <form
      method="POST"
      action="/api/portal/operator/settings/voice-samples"
      enctype="multipart/form-data"
      class="flex items-center gap-2 m-0"
    >
      <input type="hidden" name="action" value="add" />
      <label
        class="inline-flex items-center min-h-11 px-4 py-2 font-mono text-xs md:text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--ss-color-text-primary)] border-[2px] border-[color:var(--ss-color-text-primary)] hover:bg-[color:var(--ss-color-text-primary)] hover:text-[color:var(--ss-color-background)] cursor-pointer focus-within:ring-2 focus-within:ring-[color:var(--ss-color-action)] focus-within:ring-offset-2"
      >
        <span>Add sample</span>
        <input type="file" name="sample" class="sr-only" />
      </label>
    </form>
  </div>
  <p class="mt-2 text-caption text-[color:var(--ss-color-text-secondary)] m-0">
    Samples that train how your Operator writes. We surface metadata only; never the content of a
    sample.
  </p>
  <div class="mt-stack border-[3px] border-[color:var(--ss-color-text-primary)]">
    {
      samples.length === 0 ? (
        <p class="p-card text-caption text-[color:var(--ss-color-text-muted)] m-0">
          Voice samples your Operator has learned from appear here. Add a sample to begin.
        </p>
      ) : (
        <ul class="m-0 list-none p-0" role="list">
          {samples.map((sample) => (
            <li class="border-b-[2px] border-[color:var(--ss-color-text-primary)] last:border-b-0">
              <div class="flex items-baseline justify-between gap-4 flex-wrap p-card">
                <div class="min-w-0 flex-1">
                  <p class="font-body text-base md:text-lg font-black uppercase tracking-[-0.01em] text-[color:var(--ss-color-text-primary)] m-0 truncate">
                    {sample.cohort}
                  </p>
                  <p class="mt-1 text-caption text-[color:var(--ss-color-text-secondary)] m-0">
                    {sample.source} · {formatAddedAt(sample.addedAt)} ·{' '}
                    {formatVoiceSampleStatus(sample.status)}
                  </p>
                </div>
                <form
                  method="POST"
                  action="/api/portal/operator/settings/voice-samples"
                  class="m-0"
                >
                  <input type="hidden" name="action" value="remove" />
                  <input type="hidden" name="sampleId" value={sample.id} />
                  <button
                    type="submit"
                    class="inline-flex items-center min-h-11 px-4 py-2 font-mono text-xs md:text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--ss-color-text-primary)] border-[2px] border-[color:var(--ss-color-text-primary)] hover:bg-[color:var(--ss-color-text-primary)] hover:text-[color:var(--ss-color-background)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
                  >
                    Remove
                  </button>
                </form>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
