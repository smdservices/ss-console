---
/**
 * Operator PEOPLE viewer — chapter 4 of the console (console blueprint §5).
 * One shared component, both portals may mount (Lock 4); the facet registry
 * points `people` and `escalation` at the resolver this consumes.
 *
 * Five groups: who it responds to (ADR 0055 roster — kept exactly as built on
 * the retired Scope page; that block worked), who it writes to for the firm
 * (ADR 0075 outbound roster), who it escalates to, who is on the account
 * (team members, loaded by the page), and what it must never touch (block
 * lists; one plain sentence when all are empty).
 *
 * Loud register with its siblings while the calm migration is parked
 * (CALM_REGISTER_PENDING).
 */
import type { OperatorPeopleModel } from '../../../../lib/portal/operator/facets/people/people'
import type { TeamMember } from '../../../../lib/portal/operator/team-read'

interface Props {
  model: OperatorPeopleModel
  /** Team members from loadTeamRoster (DB read, page-loaded). Null = omit the group. */
  team: TeamMember[] | null
}

const { model, team } = Astro.props
const { people } = model

const groupLabel =
  'font-mono text-label font-bold uppercase tracking-[0.18em] text-[color:var(--color-text-primary)]'
const rowLabel =
  'font-mono text-label uppercase tracking-[0.14em] text-[color:var(--color-text-secondary)]'
const rowValue = 'mt-1 font-body text-sm leading-snug text-[color:var(--color-text-primary)]'
const noteText = 'mt-2 font-body text-sm leading-snug text-[color:var(--color-text-secondary)]'

const allBlocksEmpty =
  people !== null &&
  people.blockedTopics.length === 0 &&
  people.blockedSenders.length === 0 &&
  people.blockedWork.length === 0

const hasEscalation =
  people !== null &&
  (people.escalation.redFlagRecipients.length > 0 || people.escalation.failureRecipients.length > 0)
---

<section
  class="border-[3px] border-[color:var(--color-text-primary)] bg-[color:var(--color-background)]"
  aria-label="Operator people"
>
  <div
    class="bg-[color:var(--color-text-primary)] px-5 py-2.5 font-mono text-label font-bold uppercase tracking-[0.18em] text-[color:var(--color-background)]"
  >
    People
  </div>
  <div class="px-5 py-6 md:px-7">
    {
      people === null ? (
        <p class="font-mono text-label uppercase tracking-[0.14em] text-[color:var(--color-text-secondary)]">
          Who your operator works with appears here once scope is set.
        </p>
      ) : (
        <div class="flex flex-col gap-8">
          <div>
            <p class={groupLabel}>Who it responds to</p>
            {people.respondsTo.length > 0 ? (
              <>
                <p class={rowValue}>{people.respondsTo.join(', ')}</p>
                <p class={noteText}>
                  People on this list get real replies and action. Everyone else is read-only until
                  someone with authority directs otherwise.
                </p>
              </>
            ) : (
              <p class={rowValue}>
                No one yet. Until someone is added here, your operator drafts replies for review and
                sends nothing on its own.
              </p>
            )}
          </div>

          <div>
            <p class={groupLabel}>Who it writes to for the firm</p>
            {people.writesTo.length > 0 ? (
              <>
                <div class="mt-3 flex flex-col gap-3">
                  {people.writesTo.map((w) => (
                    <div>
                      <p class={rowValue}>
                        {w.address}
                        <span class="ml-2 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--color-text-secondary)]">
                          {w.classLabel}
                        </span>
                      </p>
                      {w.note && <p class={noteText}>{w.note}</p>}
                    </div>
                  ))}
                </div>
                <p class={noteText}>
                  Standing recipients a person has authorized for outbound work. This list never
                  grows on its own.
                </p>
              </>
            ) : (
              <p class={rowValue}>No standing outside recipients are configured.</p>
            )}
          </div>

          <div>
            <p class={groupLabel}>Who it escalates to</p>
            {hasEscalation ? (
              <div class="mt-3 flex flex-col gap-4">
                {people.escalation.redFlagRecipients.length > 0 && (
                  <div>
                    <p class={rowLabel}>Urgent flags</p>
                    <p class={rowValue}>{people.escalation.redFlagRecipients.join(', ')}</p>
                  </div>
                )}
                {people.escalation.failureRecipients.length > 0 && (
                  <div>
                    <p class={rowLabel}>Failures</p>
                    <p class={rowValue}>{people.escalation.failureRecipients.join(', ')}</p>
                  </div>
                )}
              </div>
            ) : (
              <p class={rowValue}>No escalation contacts are configured.</p>
            )}
          </div>

          {team !== null && (
            <div>
              <p class={groupLabel}>Who is on the account</p>
              {team.length > 0 ? (
                <div class="mt-3 flex flex-col gap-3">
                  {team.map((m) => (
                    <div>
                      <p class={rowValue}>
                        {m.name}
                        <span class="ml-2 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--color-text-secondary)]">
                          {m.roles.join(' · ')}
                        </span>
                      </p>
                      <p class={noteText}>{m.email}</p>
                    </div>
                  ))}
                </div>
              ) : (
                <p class={rowValue}>No account members yet.</p>
              )}
            </div>
          )}

          <div>
            <p class={groupLabel}>What it must never touch</p>
            {allBlocksEmpty ? (
              <p class={rowValue}>No topics, senders, or specific work are blocked.</p>
            ) : (
              <div class="mt-3 flex flex-col gap-4">
                {people.blockedTopics.length > 0 && (
                  <div>
                    <p class={rowLabel}>Blocked topics</p>
                    <p class={rowValue}>{people.blockedTopics.join(', ')}</p>
                  </div>
                )}
                {people.blockedSenders.length > 0 && (
                  <div>
                    <p class={rowLabel}>Blocked senders and domains</p>
                    <p class={rowValue}>{people.blockedSenders.join(', ')}</p>
                  </div>
                )}
                {people.blockedWork.length > 0 && (
                  <div>
                    <p class={rowLabel}>Blocked work</p>
                    <p class={rowValue}>{people.blockedWork.join(', ')}</p>
                  </div>
                )}
              </div>
            )}
          </div>
        </div>
      )
    }
  </div>
</section>
