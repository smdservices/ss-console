---
/**
 * Operator SCOPE viewer — the shared boundaries view (ADR 0069; signed-off
 * brief docs/design/operator/surface-briefs/operator-scope.md; first Boundaries
 * chapter per ADR 0076). One shared component, both portals mount (Lock 4);
 * the facet registry points `scope` at the resolver this consumes.
 *
 * Three groups: what it can see, who it responds to (the ADR 0055 roster,
 * surfaced here for the first time — empty renders the fail-closed posture as
 * plain language, never an error), and what's off limits (block lists
 * separately labeled; blocked work only when non-empty, and under a
 * vertical-neutral label per ADR 0052 §6).
 *
 * Loud register to match its siblings while the calm migration is parked;
 * registered in CALM_REGISTER_PENDING so the operator area flips together.
 */
import type { OperatorScopeModel } from '../../../../lib/portal/operator/facets/scope/scope'

interface Props {
  model: OperatorScopeModel
}

const { model } = Astro.props
const { scope } = model

const groupLabel =
  'font-mono text-label font-bold uppercase tracking-[0.18em] text-[color:var(--color-text-primary)]'
const rowLabel =
  'font-mono text-label uppercase tracking-[0.14em] text-[color:var(--color-text-secondary)]'
const rowValue = 'mt-1 font-body text-sm leading-snug text-[color:var(--color-text-primary)]'
---

<section
  class="border-[3px] border-[color:var(--color-text-primary)] bg-[color:var(--color-background)]"
  aria-label="Operator scope"
>
  <div
    class="bg-[color:var(--color-text-primary)] px-5 py-2.5 font-mono text-label font-bold uppercase tracking-[0.18em] text-[color:var(--color-background)]"
  >
    Scope
  </div>
  <div class="px-5 py-6 md:px-7">
    {
      scope === null ? (
        <p class="font-mono text-label uppercase tracking-[0.14em] text-[color:var(--color-text-secondary)]">
          Your operator's boundaries appear here once scope is set.
        </p>
      ) : (
        <div class="flex flex-col gap-8">
          <div>
            <p class={groupLabel}>What it can see</p>
            <div class="mt-3 flex flex-col gap-4">
              <div>
                <p class={rowLabel}>Sees</p>
                <p class={rowValue}>{scope.sees.length > 0 ? scope.sees.join(', ') : 'None set'}</p>
              </div>
              <div>
                <p class={rowLabel}>Never sees</p>
                <p class={rowValue}>
                  {scope.neverSees.length > 0 ? scope.neverSees.join(', ') : 'None set'}
                </p>
              </div>
            </div>
          </div>

          <div>
            <p class={groupLabel}>Who it responds to</p>
            {scope.respondsTo.length > 0 ? (
              <>
                <p class={rowValue}>{scope.respondsTo.join(', ')}</p>
                <p class="mt-2 font-body text-sm leading-snug text-[color:var(--color-text-secondary)]">
                  People on this list get real replies and action. Everyone else is read-only until
                  someone with authority directs otherwise.
                </p>
              </>
            ) : (
              <p class={rowValue}>
                No one yet. Until someone is added here, your operator drafts replies for review and
                sends nothing on its own.
              </p>
            )}
          </div>

          <div>
            <p class={groupLabel}>Who sets its standards</p>
            {scope.setsStandards.length > 0 ? (
              <>
                <p class={rowValue}>{scope.setsStandards.join(', ')}</p>
                <p class="mt-2 font-body text-sm leading-snug text-[color:var(--color-text-secondary)]">
                  These people can tell your operator how the firm's work should read, and it takes
                  effect right away. Changing this list is a request to us.
                </p>
              </>
            ) : (
              <p class={rowValue}>
                No one yet. Until someone is named here, your operator holds the standards it was
                given and changes none of them on request.
              </p>
            )}
          </div>

          <div>
            <p class={groupLabel}>Who it writes to for the firm</p>
            {scope.writesTo.length > 0 ? (
              <>
                <div class="mt-3 flex flex-col gap-3">
                  {scope.writesTo.map((w) => (
                    <div>
                      <p class={rowValue}>
                        {w.address}
                        <span class="ml-2 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--color-text-secondary)]">
                          {w.classLabel}
                        </span>
                      </p>
                      {w.note && (
                        <p class="mt-0.5 font-body text-sm leading-snug text-[color:var(--color-text-secondary)]">
                          {w.note}
                        </p>
                      )}
                    </div>
                  ))}
                </div>
                <p class="mt-2 font-body text-sm leading-snug text-[color:var(--color-text-secondary)]">
                  Standing recipients a person has authorized for outbound work. This list never
                  grows on its own.
                </p>
              </>
            ) : (
              <p class={rowValue}>No standing outside recipients are configured.</p>
            )}
          </div>

          <div>
            <p class={groupLabel}>What's off limits</p>
            <div class="mt-3 flex flex-col gap-4">
              <div>
                <p class={rowLabel}>Blocked topics</p>
                <p class={rowValue}>
                  {scope.blockedTopics.length > 0 ? scope.blockedTopics.join(', ') : 'None set'}
                </p>
              </div>
              <div>
                <p class={rowLabel}>Blocked senders and domains</p>
                <p class={rowValue}>
                  {scope.blockedSenders.length > 0 ? scope.blockedSenders.join(', ') : 'None set'}
                </p>
              </div>
              {scope.blockedWork.length > 0 && (
                <div>
                  <p class={rowLabel}>Blocked work</p>
                  <p class={rowValue}>{scope.blockedWork.join(', ')}</p>
                </div>
              )}
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>
