---
/**
 * Dashboard aliveness header — the "where is the agent right now?"
 * persistent signal (issue #875). Renders one of four states (idle,
 * running, sticky_stop, offline) plus the last-action timestamp and,
 * for the two unhealthy states, a Captain-escalation affordance.
 *
 * Calm register (UI-PATTERNS Rule 8): an inline status row — a tone
 * `StatusDot` + the level word + last-action caption, sentence case, no
 * loud pill or 3px rule. The calm counterpart to the old chip; the
 * StatusDot consumes the same `Tone` as StatusPill so tone stays unified.
 *
 * Per-customer: the signal prop is the resolved AlivenessSignal from
 * `src/lib/portal/operator/aliveness.ts :: resolveAlivenessSignal(subscription)`.
 * The component takes nothing about the subscription itself — it is a pure
 * renderer over the resolved typed signal so unit tests of the resolver and
 * the component can move independently.
 *
 * Empty-state contract: when `signal === null` (no data yet because the
 * Hermes bridge is not wired), the component renders nothing. That matches
 * `docs/style/empty-state-pattern.md` — a fabricated green chip is worse than
 * no chip at all. When the bridge lands, the resolver starts returning real
 * signals and the row appears without a component change.
 *
 * Escalation affordance: for `sticky_stop` and `offline` we surface a single
 * Captain-contact link. The `escalationHref` prop comes from the page
 * (typically a `mailto:` to the assigned consultant). When the page cannot
 * resolve one, the prop is null and the component falls back to a link to the
 * Operator settings surface where the principal can review consultant
 * assignment. The fallback is the design contract: never render an inert
 * escalation button.
 */

import StatusDot from '../StatusDot.astro'
import {
  alivenessTone,
  formatAlivenessLevel,
  formatLastActionAbsolute,
  formatLastActionRelative,
  needsEscalationAffordance,
  type AlivenessSignal,
} from '../../../lib/portal/operator/aliveness'

interface Props {
  /** Resolved aliveness signal or null when the bridge has no data. */
  signal: AlivenessSignal | null
  /**
   * Optional `mailto:` / `tel:` href the escalation affordance should
   * point at. Page typically supplies the assigned consultant's email.
   * null falls back to the Operator settings surface.
   */
  escalationHref?: string | null
  /** Optional aria label override for the escalation link. */
  escalationLabel?: string | null
}

const { signal, escalationHref = null, escalationLabel = null } = Astro.props

const level = signal?.level ?? null
const tone = level ? alivenessTone(level) : null
const headline = level ? formatAlivenessLevel(level) : ''
const lastActionRelative = signal ? formatLastActionRelative(signal.lastActionAt) : null
const lastActionAbsolute = signal ? formatLastActionAbsolute(signal.lastActionAt) : null
const showEscalation = level ? needsEscalationAffordance(level) : false
const escalationTarget = escalationHref ?? '/portal/products/operator/settings'
const escalationAria =
  escalationLabel ??
  (level === 'sticky_stop' ? 'Escalate to your consultant' : 'Contact your consultant')
---

{
  signal !== null && tone !== null && (
    <div
      aria-label="Operator status"
      data-testid="aliveness-header"
      data-aliveness-level={level}
      class="flex flex-wrap items-center gap-x-3 gap-y-1 text-caption"
    >
      <span class="inline-flex items-center gap-2">
        <StatusDot tone={tone} />
        <span class="font-medium text-[color:var(--color-text-primary)]">{headline}</span>
      </span>
      {signal.level === 'running' && signal.currentSkill && (
        <span class="text-[color:var(--color-text-secondary)]">{signal.currentSkill}</span>
      )}
      {signal.level === 'sticky_stop' && signal.stickyStopReason && (
        <span class="text-[color:var(--color-text-secondary)]">{signal.stickyStopReason}</span>
      )}
      {lastActionRelative && lastActionAbsolute && (
        <span
          class="text-[color:var(--color-text-muted)]"
          title={`Last action ${lastActionAbsolute}`}
        >
          · last action {lastActionRelative}
        </span>
      )}
      {showEscalation && (
        <a
          href={escalationTarget}
          aria-label={escalationAria}
          class="font-medium text-[color:var(--color-action)] hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-action)] focus-visible:ring-offset-2"
        >
          Contact your consultant
        </a>
      )}
    </div>
  )
}
