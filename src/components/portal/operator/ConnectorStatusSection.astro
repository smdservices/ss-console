---
/**
 * Connector status section for the Operator settings page.
 *
 * Lists every capability in customer.yaml's `connectors:` map, the
 * adapter wiring (e.g. filevine, microsoft-graph), and the current
 * health (`ok` / `warn` / `fail` / `unconfigured`).
 *
 * Health values come from the capability conformance harness's
 * `health_check()` results
 * (docs/specs/operator/capability-contracts.md). The harness is
 * not yet wired to the portal Worker; PR #949 (Filevine) and #822
 * (Microsoft Graph) own the upstream binding. Until the harness is
 * portal-bound, every row renders as `unconfigured` so the page
 * does not fabricate health.
 *
 * Re-consent path: when the harness sets `reconsentRequired: true`
 * for a connector (token expired or revoked), the row exposes a
 * "Re-authorize" affordance. Today that affordance never appears
 * because the harness is unwired; the markup is in place so the
 * future state lands one-line.
 *
 * Empty state: when customer.yaml lists no connectors, the section
 * renders the empty-state prose per
 * docs/style/empty-state-pattern.md.
 */

import type { ConnectorStatusRow } from '../../../lib/portal/operator/settings'
import { formatConnectorHealth } from '../../../lib/portal/operator/settings'

interface Props {
  rows: ConnectorStatusRow[]
}

const { rows } = Astro.props
---

<section aria-labelledby="settings-connectors-heading" class="mt-section">
  <h2
    id="settings-connectors-heading"
    class="font-['Archivo'] text-xl md:text-2xl font-black uppercase tracking-[-0.01em] text-[color:var(--ss-color-text-primary)] m-0"
  >
    Connectors
  </h2>
  <p class="mt-2 text-caption text-[color:var(--ss-color-text-secondary)] m-0">
    Systems your Operator reads from and writes to. Re-authorize a connector when its token has
    expired.
  </p>
  <div class="mt-stack border-[3px] border-[color:var(--ss-color-text-primary)]">
    {
      rows.length === 0 ? (
        <p class="p-card text-caption text-[color:var(--ss-color-text-muted)] m-0">
          Connectors your Operator uses appear here once your customer.yaml lists them.
        </p>
      ) : (
        <ul class="m-0 list-none p-0" role="list">
          {rows.map((row) => (
            <li class="border-b-[2px] border-[color:var(--ss-color-text-primary)] last:border-b-0">
              <div class="flex items-baseline justify-between gap-4 flex-wrap p-card">
                <div class="min-w-0 flex-1">
                  <p class="font-['Archivo'] text-base md:text-lg font-black uppercase tracking-[-0.01em] text-[color:var(--ss-color-text-primary)] m-0 truncate">
                    {row.capabilityName}
                  </p>
                  <p class="mt-1 text-caption text-[color:var(--ss-color-text-secondary)] m-0">
                    {row.adapter ? `${row.adapter} · ` : ''}
                    {formatConnectorHealth(row.health)}
                  </p>
                </div>
                {row.reconsentRequired ? (
                  <form
                    method="POST"
                    action="/api/portal/operator/settings/connector-reconsent"
                    class="m-0"
                  >
                    <input type="hidden" name="capabilityName" value={row.capabilityName} />
                    <button
                      type="submit"
                      class="inline-flex items-center min-h-11 px-4 py-2 font-['Archivo_Narrow'] text-xs md:text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--ss-color-text-primary)] border-[2px] border-[color:var(--ss-color-text-primary)] hover:bg-[color:var(--ss-color-text-primary)] hover:text-[color:var(--ss-color-background)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
                    >
                      Re-authorize
                    </button>
                  </form>
                ) : null}
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
