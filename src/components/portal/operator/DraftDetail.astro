---
/**
 * Draft detail surface for the Approve & Send flow.
 *
 * Renders the four review panes a reviewer needs before approving:
 *
 *   1. Identity strip   — reviewer (sender), recipient, subject, persona
 *   2. Message body     — the actual plain-text draft, fixed-pitch so
 *                         line breaks and signature alignment read as they
 *                         will when the message ships
 *   3. Reviewer attestation — "Drafted by [persona] on [ts]" preamble
 *                             that ADR 0005 says is part of the audit
 *                             trail and is stripped before send
 *   4. Approve & Send  — the action surface (button + undo + status),
 *                        rendered by ApproveAndSendButton on the client
 *                        because the undo window is JS-bound
 *
 * The detail surface is the on-stage moment of the beta-1 demo per
 * ADR 0005 §References / PRD §16. Visual weight tilts toward the
 * message body and the primary action — secondary chrome (the
 * "drafted by" preamble, the audit hint) is set in muted tone so the
 * scan-time hierarchy reads: read the message → approve.
 *
 * No fabrication: every field comes from the resolved `DraftDetail`.
 * Missing fields render their explicit empty-state marker; the
 * component never invents a fallback (per docs/style/empty-state-pattern.md).
 */

import StatusPill from '../StatusPill.astro'
import ApproveAndSendButton from './ApproveAndSendButton.astro'
import {
  formatDraftAge,
  formatDraftSendStatus,
  formatTrustCeiling,
  type DraftDetail,
  type DraftSendStatus,
} from '../../../lib/portal/operator/drafts'
import type { Tone } from '../../../lib/portal/status'

interface Props {
  draft: DraftDetail
  /**
   * Caller's resolved role on this product. Determines whether
   * Approve & Send is rendered as an actionable button or read-only.
   * 'compliance' is the read-only role per ADR 0005 — the access
   * gate redirects compliance off this page in practice, but the
   * component still guards the action in case future RBAC widens
   * the read path.
   */
  callerRole: 'principal' | 'staff' | 'compliance'
  /**
   * Reviewer's email address — the identity the message will ship
   * from per ADR 0005. Shown in the sender strip and surfaced
   * verbatim in the confirmation toast.
   */
  reviewerEmail: string
  /**
   * Reviewer's display name. Optional — falls back to email when
   * absent. Used in "Approving as ..." text.
   */
  reviewerDisplayName: string | null
  /**
   * Undo window in milliseconds, resolved server-side from
   * `customer.yaml send.undo_window_seconds` (default 5_000).
   * Passed through to ApproveAndSendButton.
   */
  undoWindowMs: number
}

const { draft, callerRole, reviewerEmail, reviewerDisplayName, undoWindowMs } = Astro.props

// Status tone mirrors the queue row: high-trust ceiling (auto_send)
// gets the warning tone so reviewers spot it at the detail level too.
const trustTone = draft.trustCeiling === 'auto_send' ? 'warning' : 'neutral'
const trustLabel = formatTrustCeiling(draft.trustCeiling).toUpperCase()

// Send-status tone. Closed vocabulary; map per drafts.ts.
const SEND_TONE: Record<DraftSendStatus, Tone> = {
  pending: 'info',
  sending: 'warning',
  sent: 'success',
  send_failed: 'danger',
}
const sendTone = SEND_TONE[draft.sendStatus]
const sendLabel = formatDraftSendStatus(draft.sendStatus).toUpperCase()

const canApprove = callerRole === 'principal' || callerRole === 'staff'

// Human-friendly date for the "drafted by [persona] on [ts]" preamble.
// We format on the server so the rendered HTML is deterministic and
// no client-side locale skew creeps in.
const personaDraftedDate = (() => {
  const d = new Date(draft.personaDraftedAt)
  if (Number.isNaN(d.getTime())) return draft.personaDraftedAt
  return d.toLocaleString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    timeZoneName: 'short',
  })
})()
---

<article class="flex flex-col gap-stack">
  {/* Identity strip — who, to whom, what about */}
  <section
    aria-label="Draft identity"
    class="border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-surface)]"
  >
    <header
      class="flex flex-wrap items-center gap-3 px-5 md:px-6 py-3 md:py-4 border-b-[2px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-primary)]"
    >
      <span class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold">
        Draft
      </span>
      <span class="font-mono text-sm">{draft.id}</span>
      <span class="ml-auto flex items-center gap-3">
        <StatusPill tone={trustTone} label={trustLabel} size="base" />
        <StatusPill tone={sendTone} label={sendLabel} size="base" />
      </span>
    </header>

    <dl
      class="grid grid-cols-1 md:grid-cols-2 gap-0 md:gap-px bg-[color:var(--ss-color-text-primary)]"
    >
      <div class="bg-[color:var(--ss-color-surface)] px-5 md:px-6 py-4 md:py-5 flex flex-col gap-1">
        <dt
          class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-semibold text-[color:var(--ss-color-text-secondary)]"
        >
          From
        </dt>
        <dd class="font-['Archivo'] font-bold text-[color:var(--ss-color-text-primary)]">
          {draft.sender}
        </dd>
      </div>
      <div class="bg-[color:var(--ss-color-surface)] px-5 md:px-6 py-4 md:py-5 flex flex-col gap-1">
        <dt
          class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-semibold text-[color:var(--ss-color-text-secondary)]"
        >
          To
        </dt>
        <dd class="font-mono text-sm text-[color:var(--ss-color-text-primary)] break-all">
          {draft.recipient}
        </dd>
      </div>
      <div class="bg-[color:var(--ss-color-surface)] px-5 md:px-6 py-4 md:py-5 flex flex-col gap-1">
        <dt
          class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-semibold text-[color:var(--ss-color-text-secondary)]"
        >
          Skill
        </dt>
        <dd class="font-mono text-sm text-[color:var(--ss-color-text-primary)]">
          {draft.skill}
        </dd>
      </div>
      <div class="bg-[color:var(--ss-color-surface)] px-5 md:px-6 py-4 md:py-5 flex flex-col gap-1">
        <dt
          class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-semibold text-[color:var(--ss-color-text-secondary)]"
        >
          Drafted
        </dt>
        <dd class="font-mono text-sm text-[color:var(--ss-color-text-primary)]">
          {formatDraftAge(draft.ageSeconds)}
        </dd>
      </div>
    </dl>
  </section>

  {/* Subject + message body */}
  <section
    aria-label="Draft message"
    class="border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-surface)]"
  >
    {
      draft.subject !== null && draft.subject !== '' ? (
        <header class="px-5 md:px-6 py-4 md:py-5 border-b-[2px] border-[color:var(--ss-color-text-primary)]">
          <span class="block font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-semibold text-[color:var(--ss-color-text-secondary)]">
            Subject
          </span>
          <h2 class="mt-1 font-['Archivo'] font-bold text-xl text-[color:var(--ss-color-text-primary)]">
            {draft.subject}
          </h2>
        </header>
      ) : (
        <header class="px-5 md:px-6 py-4 md:py-5 border-b-[2px] border-[color:var(--ss-color-text-primary)]">
          <span class="block font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-semibold text-[color:var(--ss-color-text-secondary)]">
            Subject
          </span>
          <p class="mt-1 font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
            (No subject)
          </p>
        </header>
      )
    }

    <div class="px-5 md:px-6 py-5 md:py-6">
      <pre
        class="font-mono text-sm md:text-base leading-relaxed whitespace-pre-wrap break-words text-[color:var(--ss-color-text-primary)]">{draft.bodyPlain}</pre>
    </div>

    {
      /* "Drafted by [persona] on [ts]" preamble. Per ADR 0005, this
       preamble is part of the audit trail and is stripped before send
       so the recipient never sees the persona name. Surface here so
       the reviewer can attest before approving. */
    }
    <footer
      class="px-5 md:px-6 py-3 md:py-4 border-t-[2px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-border-subtle)]"
    >
      <p
        class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]"
      >
        Drafted by {draft.personaName} · {personaDraftedDate}
      </p>
      {
        draft.voiceProfileLabel !== null && draft.voiceProfileLabel !== '' && (
          <p
            data-testid="voice-attribution"
            class="mt-1 font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]"
          >
            Shaped in {draft.voiceProfileLabel}
          </p>
        )
      }
      <p
        class="mt-1 font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]"
      >
        This line stays in your audit log. It is removed before the message ships.
      </p>
    </footer>
  </section>

  {
    /* Inline error from the last failed send attempt. Per AC: error
     handling — if send fails, draft returns to queue with status and
     the error is displayed inline. */
  }
  {
    draft.sendStatus === 'send_failed' && draft.sendError !== null && (
      <section
        aria-label="Send failure"
        role="alert"
        class="border-[3px] border-[color:var(--ss-color-error)] bg-[color:var(--ss-color-surface)] p-5 md:p-6"
      >
        <p class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-error)]">
          Last send attempt failed
        </p>
        <p class="mt-2 font-['Archivo'] text-[color:var(--ss-color-text-primary)]">
          {draft.sendError}
        </p>
      </section>
    )
  }

  {/* Approve & Send surface */}
  {
    canApprove ? (
      <ApproveAndSendButton
        draftId={draft.id}
        reviewerEmail={reviewerEmail}
        reviewerDisplayName={reviewerDisplayName}
        undoWindowMs={undoWindowMs}
        alreadySent={draft.sendStatus === 'sent'}
      />
    ) : (
      <section
        aria-label="Read-only access"
        class="border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-surface)] p-5 md:p-6"
      >
        <p class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-semibold text-[color:var(--ss-color-text-secondary)]">
          Read-only view
        </p>
        <p class="mt-2 font-['Archivo'] text-[color:var(--ss-color-text-primary)]">
          Your role on this Operator subscription does not include sending. A principal or operator
          must approve and send this draft.
        </p>
      </section>
    )
  }
</article>
