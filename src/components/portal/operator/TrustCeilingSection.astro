---
/**
 * Trust ceiling section for the Operator settings page.
 *
 * Lists every skill the active persona configures, plus a dropdown
 * exposing the closed-vocabulary ceiling
 * (`autonomous` / `draft_for_review` / `refused`). Today the
 * dropdown POSTs to the settings endpoint, which logs intent only —
 * the customer.yaml write path lands in a follow-on once the
 * configs-repo write surface ships. The page renders the dropdown
 * so the contract is locked even though the write is a no-op.
 *
 * Per ADR 0005 / PR #948 / PR #953, the Hermes-side enforcement
 * (sticky-stop on `refused`, trust-ceiling logging on every
 * generation) is already in place on the runtime. Changing the
 * value here changes nothing today because the write does not yet
 * propagate; we render the disabled state and a footnote so a
 * customer principal does not think their click has shipped.
 *
 * Empty state: when no skills are configured the section renders
 * the empty-state prose per docs/style/empty-state-pattern.md.
 */

import type { TrustCeilingRow, TrustCeilingLevel } from '../../../lib/portal/operator/settings'
import {
  TRUST_CEILING_LEVELS,
  formatTrustCeilingLevel,
} from '../../../lib/portal/operator/settings'

interface Props {
  rows: TrustCeilingRow[]
  personaSlug: string | null
}

const { rows, personaSlug } = Astro.props

function levelOptions(): TrustCeilingLevel[] {
  return TRUST_CEILING_LEVELS.slice()
}
---

<section aria-labelledby="settings-trust-ceiling-heading" class="mt-section">
  <h2
    id="settings-trust-ceiling-heading"
    class="font-['Archivo'] text-xl md:text-2xl font-black uppercase tracking-[-0.01em] text-[color:var(--ss-color-text-primary)] m-0"
  >
    Trust ceiling
  </h2>
  <p class="mt-2 text-caption text-[color:var(--ss-color-text-secondary)] m-0">
    How much your Operator can do without a reviewer in the loop, per skill.
  </p>
  <div class="mt-stack border-[3px] border-[color:var(--ss-color-text-primary)]">
    {
      rows.length === 0 ? (
        <p class="p-card text-caption text-[color:var(--ss-color-text-muted)] m-0">
          Trust ceiling controls land here once your Operator has skills configured.
        </p>
      ) : (
        <ul class="m-0 list-none p-0" role="list">
          {rows.map((row) => (
            <li class="border-b-[2px] border-[color:var(--ss-color-text-primary)] last:border-b-0">
              <form
                method="POST"
                action="/api/portal/operator/settings/trust-ceiling"
                class="flex items-baseline justify-between gap-4 flex-wrap p-card"
              >
                <input type="hidden" name="skillName" value={row.skillName} />
                {personaSlug ? (
                  <input type="hidden" name="personaSlug" value={personaSlug} />
                ) : null}
                <div class="min-w-0 flex-1">
                  <p class="font-['Archivo'] text-base md:text-lg font-black uppercase tracking-[-0.01em] text-[color:var(--ss-color-text-primary)] m-0 truncate">
                    {row.skillName}
                  </p>
                  {row.currentLevel === null && row.rawLevel ? (
                    <p class="mt-1 text-caption text-[color:var(--ss-color-text-muted)] m-0">
                      Unknown ceiling in customer.yaml: <code>{row.rawLevel}</code>
                    </p>
                  ) : null}
                </div>
                <label class="flex items-center gap-2 m-0">
                  <span class="sr-only">Trust ceiling for {row.skillName}</span>
                  <select
                    name="level"
                    class="min-h-11 px-3 py-2 border-[2px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-background)] text-[color:var(--ss-color-text-primary)] font-['Archivo_Narrow'] text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
                  >
                    {levelOptions().map((level) => (
                      <option value={level} selected={row.currentLevel === level}>
                        {formatTrustCeilingLevel(level)}
                      </option>
                    ))}
                  </select>
                </label>
                <button
                  type="submit"
                  class="inline-flex items-center min-h-11 px-4 py-2 font-['Archivo_Narrow'] text-xs md:text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--ss-color-text-primary)] border-[2px] border-[color:var(--ss-color-text-primary)] hover:bg-[color:var(--ss-color-text-primary)] hover:text-[color:var(--ss-color-background)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
                >
                  Save
                </button>
              </form>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
