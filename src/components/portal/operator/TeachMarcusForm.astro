---
/**
 * Inline rule-add form — "Teach [persona]" affordance (#810).
 *
 * Per platform-prd.md §10.3 and UX Lead Gap 2, the partner adds a
 * memory rule during draft review without leaving the page. This
 * component renders the form body inside a native <dialog> opened by
 * TeachMarcusButton. The dialog stays on the draft detail page so the
 * partner keeps their reading context — no tab switch, no full-page
 * route.
 *
 * Form fields (per the issue spec):
 *   - Rule kind: <select> over the closed MEMORY_RULE_KINDS vocab
 *   - Rule text: <textarea>, capped at MEMORY_RULE_TEXT_MAX_LENGTH
 *   - Recipient cohort (optional): single-line text input. Surfaces
 *     only when the partner picks `recipient_cohort` as the kind, but
 *     is always present in the DOM (hidden via [data-cohort-only]) so
 *     the field state survives kind-switch round-trips without JS
 *     remount.
 *
 * Persona name handling:
 *   The form's submit label uses the active persona name passed in
 *   from the page (`personaName` prop, read from `getActivePersona`).
 *   Default fallback is "Add rule" — never a hardcoded fixture name
 *   (no "Marcus" in shipped user-facing copy). The page is the single
 *   source for the persona label; the component never invents one.
 *
 * Submit pathway:
 *   POSTs JSON to /api/portal/operator/drafts/:id/teach. Client-
 *   side JS (in TeachMarcusButton) intercepts the submit, posts the
 *   payload, and renders the confirmation toast or inline error. The
 *   form falls back to a standard submit on no-JS, in which case the
 *   API returns a 303 to the draft page with a status query param.
 *
 * Accessibility:
 *   - Every field has an explicit <label>.
 *   - The textarea announces its character cap to assistive tech via
 *     aria-describedby pointing at the help text.
 *   - The dialog is opened by the trigger button; the dialog wrapper
 *     in TeachMarcusButton.astro carries the aria-modal / role
 *     attributes.
 */

import {
  MEMORY_RULE_KINDS,
  MEMORY_RULE_TEXT_MAX_LENGTH,
  formatMemoryRuleKind,
} from '../../../lib/portal/operator/teach-marcus'

interface Props {
  draftId: string
  /**
   * Submit-button label persona. When the active persona name is
   * available the form button reads "Teach {name}"; when null the
   * form uses the generic "Add rule" label. Never a hardcoded
   * fixture string.
   */
  personaName: string | null
}

const { draftId, personaName } = Astro.props

const submitLabel =
  personaName !== null && personaName.length > 0 ? `Teach ${personaName}` : 'Add rule'
const teachUrl = `/api/portal/operator/drafts/${encodeURIComponent(draftId)}/teach`
---

<form
  method="POST"
  action={teachUrl}
  data-teach-form
  data-teach-url={teachUrl}
  class="flex flex-col gap-stack"
>
  <div class="flex flex-col gap-2">
    <label
      for="teach-rule-kind"
      class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-primary)]"
    >
      Rule kind
    </label>
    <select
      id="teach-rule-kind"
      name="kind"
      required
      data-teach-kind
      class="min-h-11 px-3 py-2 border-[2px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-surface)] font-['Archivo'] text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
    >
      <option value="" disabled selected>Pick a kind</option>
      {MEMORY_RULE_KINDS.map((kind) => <option value={kind}>{formatMemoryRuleKind(kind)}</option>)}
    </select>
  </div>

  <div class="flex flex-col gap-2">
    <label
      for="teach-rule-text"
      class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-primary)]"
    >
      Rule
    </label>
    <textarea
      id="teach-rule-text"
      name="text"
      required
      rows="4"
      maxlength={MEMORY_RULE_TEXT_MAX_LENGTH}
      aria-describedby="teach-rule-help"
      data-teach-text
      class="min-h-[8rem] px-3 py-2 border-[2px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-surface)] font-['Archivo'] text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
    ></textarea>
    <p
      id="teach-rule-help"
      class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]"
    >
      Up to {MEMORY_RULE_TEXT_MAX_LENGTH} characters. The rule applies on future drafts.
    </p>
  </div>

  <div class="flex flex-col gap-2" data-cohort-row hidden>
    <label
      for="teach-rule-cohort"
      class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-primary)]"
    >
      Applies to this recipient cohort
    </label>
    <input
      id="teach-rule-cohort"
      type="text"
      name="recipientCohort"
      maxlength="120"
      autocomplete="off"
      data-teach-cohort
      class="min-h-11 px-3 py-2 border-[2px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-surface)] font-['Archivo'] text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
    />
  </div>

  <p
    data-teach-error
    role="alert"
    hidden
    class="font-['Archivo'] text-[color:var(--ss-color-error)]"
  >
  </p>

  <div class="flex flex-wrap items-center justify-end gap-3 pt-2">
    <button
      type="button"
      data-teach-cancel
      class="inline-flex items-center min-h-11 px-4 py-2 border-[2px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-surface)] font-['Archivo_Narrow'] text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
    >
      Cancel
    </button>
    <button
      type="submit"
      data-teach-submit
      class="inline-flex items-center min-h-11 px-5 py-2 bg-[color:var(--ss-color-primary)] text-[color:var(--ss-color-background)] font-['Archivo_Narrow'] text-sm font-bold uppercase tracking-[0.14em] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
    >
      {submitLabel}
    </button>
  </div>
</form>
