---
/**
 * Skill toggles section for the Operator settings page.
 *
 * Lists every skill configured on the active persona. Each row
 * surfaces an enable/disable toggle plus the current trust ceiling
 * for context (the trust ceiling section above owns ceiling
 * mutations).
 *
 * Disabling a skill maps to setting its ceiling to `refused` in
 * customer.yaml; enabling maps back to `draft_for_review` (the
 * safe default). Today the POST endpoint logs intent and the
 * customer.yaml write happens in a follow-on once the configs-repo
 * write path lands.
 *
 * Empty state: when no skills are configured the section renders
 * the empty-state prose per docs/style/empty-state-pattern.md.
 */

import type { SkillToggleRow } from '../../../lib/portal/operator/settings'
import { formatTrustCeilingLevel } from '../../../lib/portal/operator/settings'

interface Props {
  rows: SkillToggleRow[]
  personaSlug: string | null
}

const { rows, personaSlug } = Astro.props
---

<section aria-labelledby="settings-skills-heading" class="mt-section">
  <h2
    id="settings-skills-heading"
    class="font-body text-xl md:text-2xl font-black uppercase tracking-[-0.01em] text-[color:var(--ss-color-text-primary)] m-0"
  >
    Skills
  </h2>
  <p class="mt-2 text-caption text-[color:var(--ss-color-text-secondary)] m-0">
    Which skills your Operator runs. Disabled skills stay configured but never run.
  </p>
  <div class="mt-stack border-[3px] border-[color:var(--ss-color-text-primary)]">
    {
      rows.length === 0 ? (
        <p class="p-card text-caption text-[color:var(--ss-color-text-muted)] m-0">
          Skills your Operator can run appear here once your customer.yaml lists them.
        </p>
      ) : (
        <ul class="m-0 list-none p-0" role="list">
          {rows.map((row) => (
            <li class="border-b-[2px] border-[color:var(--ss-color-text-primary)] last:border-b-0">
              <form
                method="POST"
                action="/api/portal/operator/settings/skill-toggle"
                class="flex items-baseline justify-between gap-4 flex-wrap p-card"
              >
                <input type="hidden" name="skillName" value={row.skillName} />
                {personaSlug ? (
                  <input type="hidden" name="personaSlug" value={personaSlug} />
                ) : null}
                <input type="hidden" name="nextEnabled" value={row.enabled ? 'false' : 'true'} />
                <div class="min-w-0 flex-1">
                  <p class="font-body text-base md:text-lg font-black uppercase tracking-[-0.01em] text-[color:var(--ss-color-text-primary)] m-0 truncate">
                    {row.skillName}
                  </p>
                  <p class="mt-1 text-caption text-[color:var(--ss-color-text-secondary)] m-0">
                    {row.enabled ? 'Enabled' : 'Disabled'}
                    {row.trustCeiling && row.enabled
                      ? ` · ${formatTrustCeilingLevel(row.trustCeiling)}`
                      : ''}
                  </p>
                </div>
                <button
                  type="submit"
                  class="inline-flex items-center min-h-11 px-4 py-2 font-mono text-xs md:text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--ss-color-text-primary)] border-[2px] border-[color:var(--ss-color-text-primary)] hover:bg-[color:var(--ss-color-text-primary)] hover:text-[color:var(--ss-color-background)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
                >
                  {row.enabled ? 'Disable' : 'Enable'}
                </button>
              </form>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
