---
/**
 * Approve & Send action surface — the primary action of the Operator
 * draft detail page.
 *
 * Per UI-PATTERNS.md R3 (button hierarchy: one primary per view), this
 * is the only primary CTA on the detail page. Sticky-to-bottom on
 * mobile, inline on desktop. Tap target ≥ 44px per WCAG 2.2 SC 2.5.5.
 *
 * Behavior (ADR 0005 + issue #870 ACs):
 *
 *   1. Initial state: a single primary button "Approve & Send"
 *      labelled with the reviewer's email so it's clear under whose
 *      identity the message will ship.
 *
 *   2. On click: a confirmation step (multi-stage button per
 *      UI-PATTERNS.md confirmation pattern). The button collapses into
 *      a two-button row: "Confirm send" + "Cancel". This is the
 *      "are you sure" beat that prevents accidental sends without
 *      surfacing a modal — modals lose the reviewer's place on mobile.
 *
 *   3. On confirm: the undo window opens. A toast appears with a
 *      countdown and an "Undo" button. The form submits when the
 *      window expires, OR the Undo button cancels the send.
 *
 *   4. On send response: the toast turns into a confirmation banner
 *      ("Sent under <reviewerEmail>"), or an inline error if the
 *      server returned `send_failed`.
 *
 * No fake send confirmation. The "Sent" state requires the server to
 * return a successful response. When the connector is pending (#822),
 * the server returns `pending_connector` and the UI says so honestly
 * — no fabricated "delivered" state.
 *
 * Accessibility:
 *   - The primary button is a real <button type="submit">.
 *   - The undo toast is aria-live="polite" so screen readers hear the
 *     countdown without interrupting their existing flow.
 *   - Keyboard: Esc cancels the confirmation step; Esc within the
 *     undo window triggers Undo.
 *
 * Server contract:
 *   POST /api/portal/operator/drafts/:id/send
 *   Form body: { _action: 'send' }
 *   Response: 200 with JSON { status, reviewerEmail, sentAt, error }
 *             4xx/5xx with JSON { error: string }
 */

interface Props {
  draftId: string
  reviewerEmail: string
  reviewerDisplayName: string | null
  undoWindowMs: number
  alreadySent: boolean
}

const { draftId, reviewerEmail, reviewerDisplayName, undoWindowMs, alreadySent } = Astro.props

const sendUrl = `/api/portal/operator/drafts/${encodeURIComponent(draftId)}/send`
const reviewerLabel = reviewerDisplayName ?? reviewerEmail
---

{
  alreadySent ? (
    <section
      aria-label="Send confirmation"
      class="border-[3px] border-[color:var(--ss-color-complete)] bg-[color:var(--ss-color-surface)] p-5 md:p-6"
    >
      <p class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-complete)]">
        Sent
      </p>
      <p class="mt-2 font-['Archivo'] text-[color:var(--ss-color-text-primary)]">
        This draft was sent under {reviewerLabel}. It is on file in the audit log.
      </p>
    </section>
  ) : (
    <section
      aria-label="Approve and send"
      class="border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-surface)]"
      data-approve-and-send
      data-send-url={sendUrl}
      data-undo-window-ms={undoWindowMs}
      data-reviewer-email={reviewerEmail}
      data-reviewer-label={reviewerLabel}
    >
      <header class="px-5 md:px-6 py-3 md:py-4 border-b-[2px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-primary)]">
        <span class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold">
          Approve and send
        </span>
      </header>

      <div class="px-5 md:px-6 py-5 md:py-6 flex flex-col gap-4">
        <p class="font-['Archivo'] text-[color:var(--ss-color-text-primary)]">
          This message ships under{' '}
          <span class="font-mono text-[color:var(--ss-color-text-primary)]">{reviewerLabel}</span>
          {reviewerDisplayName !== null && (
            <>
              {' '}
              <span class="font-mono text-sm text-[color:var(--ss-color-text-secondary)]">
                &lt;{reviewerEmail}&gt;
              </span>
            </>
          )}
          . Approving lands a copy in your Sent folder.
        </p>

        {/* Stage 1: primary CTA */}
        <div data-stage="initial" class="flex flex-col md:flex-row gap-3 md:items-center">
          <button
            type="button"
            data-action="open-confirm"
            class="inline-flex items-center justify-center min-h-12 px-6 py-3 bg-[color:var(--ss-color-primary)] text-[color:var(--ss-color-background)] font-['Archivo_Narrow'] text-base font-bold uppercase tracking-[0.14em] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 hover:opacity-90 transition-opacity"
          >
            Approve and send
          </button>
        </div>

        {/* Stage 2: confirmation buttons (hidden until user clicks Approve) */}
        <div
          data-stage="confirm"
          hidden
          class="flex flex-col md:flex-row gap-3 md:items-center"
          role="group"
          aria-label="Confirm send"
        >
          <p
            data-confirm-prompt
            class="font-['Archivo'] text-[color:var(--ss-color-text-primary)] md:mr-auto"
          >
            Send this message under {reviewerLabel}?
          </p>
          <button
            type="button"
            data-action="confirm-send"
            class="inline-flex items-center justify-center min-h-12 px-6 py-3 bg-[color:var(--ss-color-primary)] text-[color:var(--ss-color-background)] font-['Archivo_Narrow'] text-base font-bold uppercase tracking-[0.14em] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 hover:opacity-90 transition-opacity"
          >
            Confirm send
          </button>
          <button
            type="button"
            data-action="cancel-confirm"
            class="inline-flex items-center justify-center min-h-12 px-5 py-3 border-2 border-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-text-primary)] font-['Archivo_Narrow'] text-base font-bold uppercase tracking-[0.14em] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 hover:bg-[color:var(--ss-color-border-subtle)] transition-colors"
          >
            Cancel
          </button>
        </div>
      </div>

      {/* Undo toast — fixed bottom on mobile, inline on desktop. Hidden
         until the reviewer confirms. aria-live="polite" so AT announces
         without barging in. */}
      <div
        data-undo-toast
        hidden
        role="status"
        aria-live="polite"
        class="md:m-6 md:rounded-none border-t-[3px] md:border-[3px] border-[color:var(--ss-color-attention)] bg-[color:var(--ss-color-attention)] text-white px-5 py-4 md:px-6 md:py-5 flex flex-col md:flex-row md:items-center gap-3"
      >
        <p class="font-['Archivo'] font-bold flex-1">
          Sending in <span data-undo-count>{Math.ceil(undoWindowMs / 1000)}</span>s. Tap Undo to
          cancel.
        </p>
        <button
          type="button"
          data-action="undo-send"
          class="inline-flex items-center justify-center min-h-12 px-6 py-2 bg-white text-[color:var(--ss-color-attention)] font-['Archivo_Narrow'] text-base font-bold uppercase tracking-[0.14em] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
        >
          Undo
        </button>
      </div>

      {/* Result banner — shown after the server responds. Tone driven
         by the `data-tone` attribute set by the client script: success,
         info (pending_connector), or danger (failure). */}
      <div
        data-result-banner
        hidden
        role="status"
        aria-live="polite"
        class="border-t-[2px] border-[color:var(--ss-color-text-primary)] px-5 md:px-6 py-4 md:py-5"
      >
        <p
          data-result-label
          class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold"
        />
        <p
          data-result-detail
          class="mt-1 font-['Archivo'] text-[color:var(--ss-color-text-primary)]"
        />
      </div>
    </section>
  )
}

{
  /* Behavior script — Astro doesn't ship a runtime, so this is a plain
    inline module. Selector-scoped to `[data-approve-and-send]` so a
    future second instance on the page (unlikely) does not collide. */
}
<script>
  type Stage = 'initial' | 'confirm' | 'undo' | 'result'

  function setStage(root: HTMLElement, stage: Stage): void {
    for (const el of root.querySelectorAll<HTMLElement>('[data-stage]')) {
      el.hidden = el.dataset.stage !== stage
    }
  }

  function showElement(el: HTMLElement | null): void {
    if (el) el.hidden = false
  }

  function hideElement(el: HTMLElement | null): void {
    if (el) el.hidden = true
  }

  interface SendApiResponse {
    status?: 'sent' | 'pending_connector' | 'failed'
    reviewerEmail?: string
    sentAt?: string | null
    error?: string | null
  }

  function init(root: HTMLElement): void {
    const sendUrl = root.dataset.sendUrl ?? ''
    const undoWindowMs = Math.max(0, Number(root.dataset.undoWindowMs ?? '5000'))
    const reviewerLabel = root.dataset.reviewerLabel ?? root.dataset.reviewerEmail ?? ''

    const undoToast = root.querySelector<HTMLElement>('[data-undo-toast]')
    const undoCount = root.querySelector<HTMLElement>('[data-undo-count]')
    const resultBanner = root.querySelector<HTMLElement>('[data-result-banner]')
    const resultLabel = root.querySelector<HTMLElement>('[data-result-label]')
    const resultDetail = root.querySelector<HTMLElement>('[data-result-detail]')

    let undoTimer: ReturnType<typeof setTimeout> | null = null
    let countdownInterval: ReturnType<typeof setInterval> | null = null
    let cancelled = false

    function clearTimers(): void {
      if (undoTimer !== null) clearTimeout(undoTimer)
      if (countdownInterval !== null) clearInterval(countdownInterval)
      undoTimer = null
      countdownInterval = null
    }

    function showResult(tone: 'success' | 'info' | 'danger', label: string, detail: string): void {
      if (!resultBanner || !resultLabel || !resultDetail) return
      resultBanner.dataset.tone = tone
      const labelClass =
        tone === 'success'
          ? 'text-[color:var(--ss-color-complete)]'
          : tone === 'danger'
            ? 'text-[color:var(--ss-color-error)]'
            : 'text-[color:var(--ss-color-primary)]'
      resultLabel.className =
        "font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold " + labelClass
      resultLabel.textContent = label
      resultDetail.textContent = detail
      showElement(resultBanner)
      hideElement(undoToast)
    }

    async function dispatchSend(): Promise<void> {
      try {
        const resp = await fetch(sendUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ confirmed: true }),
        })
        const data = (await resp.json().catch(() => ({}))) as SendApiResponse
        if (!resp.ok) {
          showResult('danger', 'Send failed', data.error ?? 'The server rejected the send.')
          return
        }
        if (data.status === 'sent') {
          showResult(
            'success',
            'Sent',
            'The message is on its way and a copy is in your Sent folder.'
          )
        } else if (data.status === 'pending_connector') {
          showResult(
            'info',
            'Approved · connector pending',
            'Your approval is on file. The send completes once your email connector is bound.'
          )
        } else if (data.status === 'failed') {
          showResult(
            'danger',
            'Send failed',
            data.error ?? 'The send pathway returned an error. The draft is back in your queue.'
          )
        } else {
          showResult('danger', 'Unexpected response', 'The server returned an unknown status.')
        }
      } catch (e) {
        const msg = e instanceof Error ? e.message : 'Network error.'
        showResult('danger', 'Send failed', msg)
      }
    }

    function startUndoWindow(): void {
      cancelled = false
      setStage(root, 'undo')
      showElement(undoToast)
      // Initialise countdown text
      let remaining = Math.ceil(undoWindowMs / 1000)
      if (undoCount) undoCount.textContent = String(remaining)
      countdownInterval = setInterval(() => {
        remaining -= 1
        if (remaining < 0) remaining = 0
        if (undoCount) undoCount.textContent = String(remaining)
      }, 1000)

      undoTimer = setTimeout(() => {
        clearTimers()
        if (cancelled) return
        // Window expired without Undo — commit the send.
        dispatchSend()
      }, undoWindowMs)
    }

    function cancelSend(): void {
      cancelled = true
      clearTimers()
      hideElement(undoToast)
      setStage(root, 'initial')
      showResult('info', 'Send cancelled', 'The draft is back in your queue. No message was sent.')
    }

    root.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null
      if (!target) return
      const action = target.closest<HTMLElement>('[data-action]')?.dataset.action
      if (!action) return

      if (action === 'open-confirm') {
        setStage(root, 'confirm')
      } else if (action === 'cancel-confirm') {
        setStage(root, 'initial')
      } else if (action === 'confirm-send') {
        if (undoWindowMs > 0) {
          startUndoWindow()
        } else {
          // No undo window configured — dispatch immediately.
          setStage(root, 'initial')
          dispatchSend()
        }
      } else if (action === 'undo-send') {
        cancelSend()
      }
    })

    // Esc handling: collapses confirm step or triggers Undo, depending
    // on which stage is visible.
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return
      const confirmVisible = root.querySelector<HTMLElement>('[data-stage="confirm"]')
      const undoVisible = undoToast && !undoToast.hidden
      if (undoVisible) {
        cancelSend()
      } else if (confirmVisible && !confirmVisible.hidden) {
        setStage(root, 'initial')
      }
    })

    // Surface the reviewer label so the bound-by line is honest.
    if (reviewerLabel) {
      // Already rendered server-side; nothing to do here. Hook reserved
      // in case future surfaces want to update the label client-side
      // (e.g., reviewer-switching control).
    }
  }

  function bootstrap(): void {
    for (const root of document.querySelectorAll<HTMLElement>('[data-approve-and-send]')) {
      init(root)
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootstrap)
  } else {
    bootstrap()
  }
</script>
