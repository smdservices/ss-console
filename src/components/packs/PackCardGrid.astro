---
// Bordered card grid for the pack pages. Items are per-vertical data from the
// page frontmatter; this component carries only the grid chrome.
//
// card maps to the three grid uses in the original pages:
//   templates - § 03 pack templates (2-col, gap-3, min-h-[12rem])
//   zones     - § 05 customization zones (3-col, gap-3, min-h-[14rem])
//   lenses    - § 07 role lenses (3-col, gap-4, min-h-[16rem])
interface Item {
  title: string
  body: string
}

interface Props {
  items: Item[]
  cols: 2 | 3
  card: 'templates' | 'zones' | 'lenses'
}

const { items, cols, card } = Astro.props

const gridClass = {
  2: 'grid grid-cols-1 md:grid-cols-2 gap-0 border-t-[3px] border-[color:var(--ss-color-text-primary)]',
  3: 'grid grid-cols-1 md:grid-cols-3 gap-0 border-t-[3px] border-[color:var(--ss-color-text-primary)]',
}[cols]

const cardClass = {
  templates:
    'flex flex-col gap-3 p-8 min-h-[12rem] border-b-[3px] border-[color:var(--ss-color-text-primary)]',
  zones:
    'flex flex-col gap-3 p-8 min-h-[14rem] border-b-[3px] border-[color:var(--ss-color-text-primary)]',
  lenses:
    'flex flex-col gap-4 p-8 min-h-[16rem] border-b-[3px] border-[color:var(--ss-color-text-primary)]',
}[card]
---

<div class={gridClass}>
  {
    items.map((item, i) => (
      <div
        class:list={[
          cardClass,
          (i + 1) % cols !== 0 &&
            'md:border-r-[3px] md:border-[color:var(--ss-color-text-primary)]',
        ]}
      >
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-primary)]">
          {item.title}
        </p>
        <p class="font-body text-base leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          {item.body}
        </p>
      </div>
    ))
  }
</div>
