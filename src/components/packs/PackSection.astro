---
// Standard section wrapper for the pack pages: full-bleed band + centered
// max-w-5xl column. Section content flows through the default slot.
interface Props {
  bg: 'white' | 'background'
}

const { bg } = Astro.props

const bgClass = {
  white: 'bg-white px-6 py-24',
  background: 'bg-[color:var(--ss-color-background)] px-6 py-24',
}[bg]
---

<section class={bgClass}>
  <div class="mx-auto max-w-5xl">
    <slot />
  </div>
</section>
