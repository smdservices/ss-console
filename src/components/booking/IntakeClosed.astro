---
/**
 * V4 /book closed-state acknowledgment card.
 *
 * Single variant: 'booked' — replaces the slot picker after the
 * prospect confirms a time. Shows the confirmed slot label and
 * (optional) reschedule link. The Google Meet join link is not
 * surfaced here — it lives on the calendar invite and confirmation
 * email where it belongs.
 *
 * The "Just send a note" path does NOT terminate here. It transitions
 * directly to the slot picker with a "Got your note" banner so the
 * prospect can optionally pick a time without an extra click. See
 * IntakeSlots.astro / book.ts.
 *
 * Pre-rendered hidden; book.ts reveals it and populates the slot text.
 */
---

<section id="intake-closed" class="ss-closed" hidden>
  <div id="closed-booked" class="ss-closed-card" data-flavor="booked">
    <p class="ss-eyebrow">Confirmed</p>
    <p id="closed-booked-slot" class="ss-headline-sm"></p>
    <div id="closed-booked-manage-row" class="ss-stack" hidden>
      <a id="closed-booked-manage-link" href="#" class="ss-quiet-link"> Reschedule or cancel </a>
    </div>
  </div>
</section>
