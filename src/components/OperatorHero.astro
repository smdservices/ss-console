---
// Home hero. Beat 1 of the firm-wraps-flagship spine: orient a stranger from any
// channel in the first screen (firm descriptor + the promise + the flagship named +
// the one door), then route to the assessment. Firm in the headline; the Operator is
// named and linked, not yet explained (that is beat 4 and /operator). Type-led, no
// graphics. Locked structure: docs/marketing/positioning-spine.md.
import CtaButton from './CtaButton.astro'
---

<section class="ss-hero relative bg-[color:var(--ss-color-background)] px-6">
  <div class="mx-auto max-w-5xl py-24 md:py-32">
    <p
      class="mb-6 font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
    >
      Software &amp; AI Solutions For Small Business
    </p>
    <h1
      class="ss-hero-h font-['Archivo'] font-black uppercase leading-[0.95] tracking-[-0.03em] text-[color:var(--ss-color-text-primary)]"
    >
      <span class="block">Figure out what's</span>
      <span class="block">slowing you down.</span>
      <span class="block text-[color:var(--ss-color-primary)]">Build the right solution.</span>
    </h1>
    <p
      class="mt-8 max-w-2xl font-['Archivo'] text-xl leading-relaxed text-[color:var(--ss-color-text-secondary)]"
    >
      We are a software and AI solutions firm for small businesses. When the work itself keeps
      falling through the cracks between your people and your software, our flagship does it: the
      Operator, a managed worker on your own systems that handles the recurring work and does not
      walk out the door. It starts with an assessment.
    </p>
    <div class="mt-9 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-7">
      <CtaButton href="/book?interest=operator" data-ev="home-hero-cta">
        Start with an assessment
      </CtaButton>
      <a
        href="/operator"
        data-ev="home-hero-operator"
        class="inline-flex items-center gap-2 font-['Archivo_Narrow'] text-sm font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-text-secondary)] underline-offset-4 hover:text-[color:var(--ss-color-text-primary)] hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
      >
        <span>See the Operator</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .ss-hero-h {
    font-size: clamp(2rem, 6vw, 4rem);
  }
</style>
