---
// Operator-forward home hero (§01). Leads on the spine: you hire people and buy
// tools, and both come off the shelf; the Operator is the third option, built for
// your business and run for you. Does not presume to know the reader's business.
// One primary CTA + a low-weight in-page scroll cue to the argument.
//
// DRAFT COPY - headline and side note are directional for the Captain's voice
// pass. The structure and CTA wiring are final.
import CtaButton from './CtaButton.astro'
---

<section class="bg-[color:var(--ss-color-background)] px-6">
  <div class="mx-auto max-w-5xl">
    <span
      class="inline-block bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.14em] px-2 py-1 mt-16 md:mt-20"
      >§ 01</span
    >
    <div class="grid grid-cols-1 md:grid-cols-12">
      <div
        class="md:col-span-8 pt-8 pb-16 md:pt-10 md:pb-24 md:pr-10 border-b-[3px] md:border-b-0 border-[color:var(--ss-color-text-primary)]"
      >
        <h1
          class="font-['Archivo'] font-black uppercase text-[clamp(2.5rem,8vw,6rem)] leading-[0.9] tracking-[-0.04em] text-[color:var(--ss-color-text-primary)]"
        >
          <span class="block">Not Hired.</span>
          <span class="block">Not Bought.</span>
          <span class="block text-[color:var(--ss-color-primary)]">Built.</span>
        </h1>
        <div class="mt-10 md:mt-12 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
          <CtaButton
            href="/book?interest=operator"
            data-ev="home-operator-hero-cta"
            class="w-full sm:w-auto"
          >
            Get in touch
          </CtaButton>
          <a
            href="#how"
            data-ev="home-hero-scroll"
            class="inline-flex items-center gap-2 font-['Archivo_Narrow'] text-sm font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-text-secondary)] hover:text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
          >
            <span>See how it works</span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
      <div
        class="md:col-span-4 flex flex-col items-start py-10 md:pt-10 md:pb-14 md:pl-10 md:border-l-[3px] md:border-[color:var(--ss-color-text-primary)]"
      >
        <p
          class="font-['Archivo'] text-sm md:text-base leading-relaxed text-balance text-[color:var(--ss-color-text-secondary)]"
        >
          People and tools come off the shelf. Your business doesn't. The Operator is a worker built
          for how you work, and we run it for you.
        </p>
        <div
          class="hidden md:block mt-8 w-12 border-t-[3px] border-[color:var(--ss-color-text-primary)]"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>
  </div>
</section>
