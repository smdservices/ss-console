---
// Operator-forward home hero. Type-led: it names the leak in the buyer's own
// words (concrete, cross-vertical, not the bare abstraction the prior hero used),
// then the gap as the why, the managed worker as the fill, and the door. No
// diagram; composition and type carry it. Plainspoken: cream/ink/orange, zero radius.
import CtaButton from './CtaButton.astro'
---

<section class="ss-hero relative bg-[color:var(--ss-color-background)] px-6">
  <div class="mx-auto max-w-5xl py-24 md:py-32">
    <p
      class="mb-6 font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
    >
      The Managed Operator
    </p>
    <h1
      class="ss-hero-h font-['Archivo'] font-black uppercase leading-[0.95] tracking-[-0.03em] text-[color:var(--ss-color-text-primary)]"
    >
      <span class="block">The follow-up nobody sent.</span>
      <span class="block">The handoff that stalled.</span>
      <span class="block text-[color:var(--ss-color-primary)]"
        >The work that's everyone's job and no one's.</span
      >
    </h1>
    <p
      class="mt-8 max-w-2xl font-['Archivo'] text-xl leading-relaxed text-[color:var(--ss-color-text-secondary)]"
    >
      It falls into the gap between your people and your software. The Operator is a new kind of
      worker that fills that gap. We build it around how you run, and we run it for you.
    </p>
    <div class="mt-9 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-7">
      <CtaButton href="/book?interest=operator" data-ev="home-operator-hero-cta">
        Start the conversation
      </CtaButton>
      <a
        href="/industries"
        data-ev="home-hero-industries"
        class="inline-flex items-center gap-2 font-['Archivo_Narrow'] text-sm font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-text-secondary)] underline-offset-4 hover:text-[color:var(--ss-color-text-primary)] hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
      >
        <span>Find your industry</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .ss-hero-h {
    font-size: clamp(1.9rem, 5vw, 3.5rem);
  }
</style>
