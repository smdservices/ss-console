---
/**
 * Configuration form for a generator pipeline.
 * Extracted from src/pages/admin/generators/[type].astro.
 *
 * Only the fields a worker actually reads are editable here. The former
 * `target_verticals` / `geos` textareas were a dead admin mirage (no worker
 * ever read those config keys) and were removed in the 2026-07 realignment.
 */
import {
  type JobMonitorConfig,
  type ReviewMiningConfig,
  type PipelineId,
} from '../../lib/generators/types'
import type { GeneratorConfigRow } from '../../lib/db/generators'

interface Props {
  configRow: GeneratorConfigRow
  type: PipelineId
}

const { configRow, type } = Astro.props
const jm = configRow.config as JobMonitorConfig
const rm = configRow.config as ReviewMiningConfig
---

<form
  method="POST"
  class="bg-white rounded-[var(--ss-radius-card)] border border-[color:var(--ss-color-border)] p-card space-y-stack"
>
  <input type="hidden" name="action" value="save_config" />

  <div class="flex items-center gap-row">
    <input
      type="checkbox"
      id="enabled"
      name="enabled"
      checked={configRow.enabled}
      class="w-4 h-4 rounded border-[color:var(--ss-color-border)]"
    />
    <label for="enabled" class="text-sm font-medium text-[color:var(--ss-color-text-primary)]">
      Enabled — when unchecked, worker returns early and writes no signals
    </label>
  </div>

  {
    type === 'job_monitor' && (
      <div>
        <label
          for="search_queries"
          class="text-sm font-medium text-[color:var(--ss-color-text-primary)] block mb-1"
        >
          Search queries{' '}
          <span class="text-xs text-[color:var(--ss-color-text-secondary)]">(one per line)</span>
        </label>
        <textarea
          id="search_queries"
          name="search_queries"
          rows="8"
          class="w-full border border-[color:var(--ss-color-border)] rounded px-3 py-2 text-sm font-mono"
        >
          {jm.search_queries.join('\n')}
        </textarea>
      </div>
    )
  }

  {
    type === 'review_mining' && (
      <>
        <div>
          <label
            for="discovery_queries"
            class="text-sm font-medium text-[color:var(--ss-color-text-primary)] block mb-1"
          >
            Discovery queries{' '}
            <span class="text-xs text-[color:var(--ss-color-text-secondary)]">(one per line)</span>
          </label>
          <textarea
            id="discovery_queries"
            name="discovery_queries"
            rows="10"
            class="w-full border border-[color:var(--ss-color-border)] rounded px-3 py-2 text-sm font-mono"
          >
            {rm.discovery_queries.join('\n')}
          </textarea>
        </div>
        <div>
          <label class="text-sm font-medium text-[color:var(--ss-color-text-primary)] block mb-1">
            Search area
          </label>
          <p class="text-xs text-[color:var(--ss-color-text-secondary)] mb-2">
            Google Places biases results near this point. Defaults are the Arizona centroid (34.0,
            -111.5) with a statewide radius.
          </p>
          <div class="grid grid-cols-3 gap-4">
            <div>
              <label
                for="geo_lat"
                class="text-xs text-[color:var(--ss-color-text-secondary)] block mb-1"
              >
                Latitude
              </label>
              <input
                type="number"
                id="geo_lat"
                name="geo_lat"
                value={rm.geo_center.lat}
                step="0.0001"
                class="w-full border border-[color:var(--ss-color-border)] rounded px-3 py-2 text-sm"
              />
            </div>
            <div>
              <label
                for="geo_lon"
                class="text-xs text-[color:var(--ss-color-text-secondary)] block mb-1"
              >
                Longitude
              </label>
              <input
                type="number"
                id="geo_lon"
                name="geo_lon"
                value={rm.geo_center.lon}
                step="0.0001"
                class="w-full border border-[color:var(--ss-color-border)] rounded px-3 py-2 text-sm"
              />
            </div>
            <div>
              <label
                for="geo_radius_km"
                class="text-xs text-[color:var(--ss-color-text-secondary)] block mb-1"
              >
                Radius (km, 1–500)
              </label>
              <input
                type="number"
                id="geo_radius_km"
                name="geo_radius_km"
                value={rm.geo_radius_km}
                min="1"
                max="500"
                class="w-full border border-[color:var(--ss-color-border)] rounded px-3 py-2 text-sm"
              />
            </div>
          </div>
          <button type="button" data-az-defaults class="mt-2 text-xs text-primary hover:underline">
            Reset to Arizona defaults
          </button>
        </div>
      </>
    )
  }

  <div>
    <button
      type="submit"
      class="px-4 py-2 text-sm font-medium text-white bg-primary rounded-[var(--ss-radius-card)] hover:bg-primary/90 transition-colors"
    >
      Save configuration
    </button>
  </div>
</form>
