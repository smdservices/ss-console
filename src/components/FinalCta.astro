---
import CtaButton from './CtaButton.astro'

// Optional interest attribution: pages that use FinalCta (/consulting, /ai) pass
// their SKU so the booking lands with the right entry recorded. Defaults to bare
// /book when not set.
interface Props {
  interest?: string
}
const { interest } = Astro.props
const bookHref = interest ? `/book?interest=${interest}` : '/book'
---

<section id="book" class="bg-[color:var(--ss-color-surface-inverse)] px-6 py-24">
  <div class="mx-auto max-w-5xl text-center">
    <h2
      class="font-['Archivo'] text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-white"
    >
      Let's Talk About Your Business
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-balance text-[color:var(--ss-color-text-muted)]">
      We'll ask how things run and where you're trying to go. You'll walk away with a clearer
      picture of how to get there, whether we work together or not.
    </p>
    <div class="mt-10">
      <CtaButton variant="outline-white" href={bookHref} data-ev="final-cta-book">
        Start the conversation
      </CtaButton>
    </div>
  </div>
</section>
