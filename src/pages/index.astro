---
// SSR required: middleware needs to intercept portal.smd.services requests to this path
// and rewrite them to /portal. The prerendered static file would bypass the Worker entirely.
export const prerender = false

// Operator-forward home: the SPINE. It hooks the leak (hero), names the gap as
// the why and the managed worker as the fill (one belief beat, the leash), routes
// the buyer to their vertical pack, offers the consulting second door, the founder,
// and one door. It is NOT the manifesto: the full category argument is gone, the
// mechanism lives on /operator, the comparison Q&A lives on /why, vertical
// recognition lives on the packs. Each idea is argued in exactly one place.
//
// DRAFT COPY in the inline sections is directional, for the Captain's voice pass.
// Structure, IA, and CTA wiring are final.
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import OperatorHero from '../components/OperatorHero.astro'
import ConsultingPath from '../components/ConsultingPath.astro'
import About from '../components/About.astro'
import Footer from '../components/Footer.astro'
import CtaButton from '../components/CtaButton.astro'
import { CATEGORY_NAME } from '../lib/category'

const categorySchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Operator',
  category: CATEGORY_NAME,
  description:
    'A dedicated Operator, built for your business and given a real role. It takes on the recurring connective work a business would otherwise hire a person to do, on its own isolated infrastructure, with the operating memory it builds belonging to you. Run for you as a flat monthly service.',
  brand: { '@type': 'Brand', name: 'SMD Services' },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: 'SMD Services' },
  },
}
---

<Base
  title="SMD Services | The Operator, For The Work In Between"
  description="The work that falls between your people and your software still gets done by hand. The Operator is a new kind of worker that fills that gap, built around how you run and managed by us."
>
  <Nav />
  <main id="main" role="main">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(categorySchema)} />

    <OperatorHero />

    <!-- What it is: the category + the fill, brief. Not the mechanism (that is /operator). -->
    <section id="how" class="bg-white px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          A New Kind Of Worker
        </p>
        <h2
          class="mb-10 font-['Archivo'] text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          It Fills The Gap. You Stop Bridging It By Hand.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            Your people are good and your software is good. The work that falls between them, the
            handoff from one system to the next, the follow-up that slips, the step that is
            everyone's job and no one's, still comes down to a person holding it together by hand.
          </p>
          <p>
            The Operator is built for exactly that. It works across the tools you already run, takes
            on the recurring connective work, and keeps the pieces moving so nothing falls through.
            Not a person you hire, not a tool you buy. A worker that fills the gap.
          </p>
          <p>
            <a
              href="/why"
              data-ev="home-why-link"
              class="inline-flex items-center gap-2 font-['Archivo_Narrow'] text-sm font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-primary)] hover:text-[color:var(--ss-color-primary-hover)]"
            >
              <span>See how it compares to a hire, a tool, or a chatbot</span>
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- The reason to believe: the leash. Managed, you set the limits, we run it. Brief; the
         operational detail lives on /operator. -->
    <section class="bg-[color:var(--ss-color-background)] px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          Managed For You
        </p>
        <h2
          class="mb-10 font-['Archivo'] text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          Managed, Not Handed Over.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            You decide what the Operator can do on its own and what waits for a person to approve,
            and you can change that line whenever you want. It works inside the limits you set,
            nothing more.
          </p>
          <p>
            And running it is our job, not yours. We build it for your business, wire it into your
            tools, and stay accountable for how it works. A service, not software you have to
            manage. As the field keeps moving, keeping your Operator current is on us.
          </p>
          <p>
            <a
              href="/operator"
              data-ev="home-operator-learn"
              class="inline-flex items-center gap-2 font-['Archivo_Narrow'] text-sm font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-primary)] hover:text-[color:var(--ss-color-primary-hover)]"
            >
              <span>See how it works</span>
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- The router: send the buyer to their vertical, where the leak gets concrete. -->
    <section class="bg-white px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <p
          class="mb-5 font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-secondary)]"
        >
          Built Around How You Run
        </p>
        <h2
          class="mb-8 font-['Archivo'] text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          Start With Your Industry.
        </h2>
        <p
          class="mb-10 max-w-2xl text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]"
        >
          The work that falls through takes a recognizable shape in every trade. We have mapped the
          seat the Operator fills for law firms, insurance agencies, accounting firms, med spas,
          home services, and more. Find yours.
        </p>
        <CtaButton variant="secondary" href="/industries" data-ev="home-industries-router"
          >Find your industry</CtaButton
        >
      </div>
    </section>

    <ConsultingPath />

    <About />

    <!-- Start the conversation (single primary CTA; outcome-neutral, Operator-forward). -->
    <section class="bg-[color:var(--ss-color-surface-inverse)] px-6 py-24">
      <div class="mx-auto max-w-5xl text-center">
        <p
          class="mb-6 font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.18em] text-[color:var(--ss-color-text-muted)]"
        >
          Start Here
        </p>
        <h2
          class="mb-6 font-['Archivo'] text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-white"
        >
          Start The Conversation.
        </h2>
        <p class="mx-auto mb-10 max-w-2xl text-lg text-[color:var(--ss-color-text-muted)]">
          It starts with a conversation. We learn how your operation runs, find the work that is
          eating your team's time, and figure out the right solution for your business. If the
          Operator is not the right fit, we say so.
        </p>
        <CtaButton variant="outline-white" href="/book?interest=operator" data-ev="home-final-cta"
          >Start the conversation</CtaButton
        >
      </div>
    </section>
  </main>
  <Footer />
</Base>
