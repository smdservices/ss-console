---
// SSR required: middleware needs to intercept portal.smd.services requests to this path
// and rewrite them to /portal. The prerendered static file would bypass the Worker entirely.
export const prerender = false

// The scope-based solutions-consulting path. This is the firm's original front
// door, extracted here intact when the apex home moved Operator-forward
// (Operator-forward redesign, 2026-06). Composition mirrors the prior home so
// the consulting experience is preserved, not lost.
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import ProblemCards from '../components/ProblemCards.astro'
import RoiMath from '../components/RoiMath.astro'
import HowWeEngage from '../components/HowWeEngage.astro'
import HowWePrice from '../components/HowWePrice.astro'
import WhatYouGet from '../components/WhatYouGet.astro'
import OperatorIntro from '../components/OperatorIntro.astro'
import CaseStudies from '../components/CaseStudies.astro'
import About from '../components/About.astro'
import FinalCta from '../components/FinalCta.astro'
import Footer from '../components/Footer.astro'
---

<Base title="SMD Services | Solutions Consulting for Growing Businesses">
  <Nav />
  <main id="main" role="main">
    <Hero />
    <ProblemCards />
    <RoiMath />
    <HowWeEngage />
    <HowWePrice />
    <WhatYouGet />
    <OperatorIntro />
    <CaseStudies />
    <About />
    <FinalCta />
  </main>
  <Footer />
</Base>
