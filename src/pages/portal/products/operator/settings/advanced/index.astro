---
import '../../../../../../styles/global.css'
import { BRAND_NAME } from '../../../../../../lib/config/brand'
import { getPortalClient } from '../../../../../../lib/portal/session'
import {
  getProductSubscription,
  listProductRoles,
} from '../../../../../../lib/portal/product-access'
import { getCustomerConfig } from '../../../../../../lib/portal/customer-config'
import { resolveEditableConfigFromRow } from '../../../../../../lib/portal/operator/customer-yaml-editor'
import PortalHeader from '../../../../../../components/portal/PortalHeader.astro'
import PortalTabs from '../../../../../../components/portal/PortalTabs.astro'
import PortalPageHead from '../../../../../../components/portal/PortalPageHead.astro'
import SkipToMain from '../../../../../../components/SkipToMain.astro'
import PersonaFields from '../../../../../../components/portal/operator/customer-yaml-editor/PersonaFields.astro'
import EscalationFields from '../../../../../../components/portal/operator/customer-yaml-editor/EscalationFields.astro'
import BusinessHoursFields from '../../../../../../components/portal/operator/customer-yaml-editor/BusinessHoursFields.astro'
import ConnectorsFields from '../../../../../../components/portal/operator/customer-yaml-editor/ConnectorsFields.astro'
import ScopeFields from '../../../../../../components/portal/operator/customer-yaml-editor/ScopeFields.astro'
import { env } from 'cloudflare:workers'

/**
 * Operator — advanced settings (customer.yaml editor).
 *
 * URL: portal.smd.services/portal/products/operator/settings/advanced
 *
 * Form-based editor for the customer.yaml configuration that previously
 * required Captain intervention. NOT a raw YAML textarea — every field
 * is a typed input with structured validation.
 *
 * Per ADR 0012 §4, git is the authoritative source of truth for
 * customer.yaml. The portal D1 `customer_configs` table is a read
 * replica. This editor reads from the projection, validates the
 * proposed change via the shared `src/lib/operator/customer-yaml/`
 * validator, and emits an audit event. The git write-back path is
 * out of scope at v1 and lands in a follow-on PR; until then, the
 * audit log + the validation pass are the load-bearing customer-side
 * guarantees.
 *
 * Access gate (per the issue acceptance criteria):
 *   - Clerk session (middleware enforces)
 *   - Active Operator subscription on this customer
 *   - Caller holds the 'principal' role on (entity, 'operator')
 *
 * Operators and compliance users are redirected back to the AI
 * Employee landing — the page does not render a half-locked view.
 *
 * Captain-only fields (`connector token_ref`, `safety.sticky_stop.*`,
 * `personas` length, schema/identity/runtime/memory fields) display
 * as read-only with a "Captain-managed" badge. The server-side
 * validator rejects any attempt to mutate them even if the form is
 * bypassed.
 *
 * Mutations are HTML-form POSTs to
 * /api/portal/operator/settings/customer-yaml-update. On
 * validation failure the endpoint redirects back here with
 * `?status=invalid` and the page surfaces a generic invalid banner;
 * the per-field errors are persisted in a flash table that the next
 * iteration plumbs through.
 */

const PRODUCT_SLUG = 'operator'
const SETTINGS_LANDING_URL = '/portal/products/operator/settings'

const portalData = await getPortalClient(env.DB, Astro.locals)
if (!portalData) {
  return Astro.redirect('/auth/sign-in')
}
if (!portalData.client) {
  return Astro.redirect('/auth/sign-in?status=no_subscription')
}

const { user, client } = portalData

const subscription = await getProductSubscription(env.DB, client.id, PRODUCT_SLUG)
if (!subscription) {
  return Astro.redirect('/portal/products/operator')
}

const callerRoles = await listProductRoles(env.DB, user.id, client.id, PRODUCT_SLUG)
if (!callerRoles.includes('principal')) {
  return Astro.redirect(SETTINGS_LANDING_URL)
}

const configRow = await getCustomerConfig(env.DB, client.id)

let resolved: ReturnType<typeof resolveEditableConfigFromRow> | null = null
let projectionError: string | null = null
if (configRow !== null) {
  resolved = resolveEditableConfigFromRow(configRow)
  if ('error' in resolved) {
    projectionError = `Invalid projection: ${resolved.errors.map((e) => e.path).join(', ')}`
    resolved = null
  }
}

const status = Astro.url.searchParams.get('status')
type BannerStatus = { text: string; tone: 'success' | 'error' | 'info' }
const STATUS_BANNERS: Record<string, BannerStatus> = {
  applied: { text: 'Settings saved.', tone: 'success' },
  invalid: {
    text: 'Some fields failed validation. Correct the highlighted errors and resubmit.',
    tone: 'error',
  },
  forbidden: {
    text: 'You do not have permission to make this change.',
    tone: 'error',
  },
  no_config: {
    text: 'No customer configuration is currently projected. Contact Captain.',
    tone: 'error',
  },
  internal_error: {
    text: 'A server error occurred while saving. Try again or contact Captain.',
    tone: 'error',
  },
}
const banner = status ? (STATUS_BANNERS[status] ?? null) : null

const editable = resolved && !('error' in resolved) ? resolved.editable : null
const locked = resolved && !('error' in resolved) ? resolved.locked : null
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;900&family=Archivo+Narrow:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>Operator · Advanced settings | {BRAND_NAME}</title>
  </head>
  <body class="min-h-screen bg-[color:var(--ss-color-background)]">
    <SkipToMain />
    <PortalHeader clientName={client.name} />

    <PortalTabs pathname={Astro.url.pathname} operatorActive={true} />

    <main id="main" role="main" class="max-w-5xl mx-auto px-4 md:px-6 pb-24 md:pb-12">
      <PortalPageHead
        crumbHref={SETTINGS_LANDING_URL}
        crumbLabel="Settings"
        tag="Section"
        h1="Advanced"
        meta={null}
      />

      {
        banner && (
          <div
            role="status"
            class:list={[
              'mt-6 px-4 py-3 border-[3px] text-sm',
              banner.tone === 'success'
                ? 'border-[color:var(--ss-color-complete)] bg-[color:var(--ss-color-complete)]/10 text-[color:var(--ss-color-complete)]'
                : banner.tone === 'error'
                  ? 'border-[color:var(--ss-color-error)] bg-[color:var(--ss-color-error)]/10 text-[color:var(--ss-color-error)]'
                  : 'border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-border-subtle)] text-[color:var(--ss-color-text-primary)]',
            ]}
          >
            {banner.text}
          </div>
        )
      }

      {
        configRow === null ? (
          <section class="mt-10">
            <div class="border-[3px] border-[color:var(--ss-color-text-primary)] p-8 md:p-12 text-center">
              <p class="font-['Archivo'] text-2xl md:text-3xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]">
                No configuration found
              </p>
              <p class="mt-3 font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
                Your customer.yaml has not been projected yet. Contact Captain to provision the
                editor surface.
              </p>
            </div>
          </section>
        ) : projectionError !== null ? (
          <section class="mt-10">
            <div class="border-[3px] border-[color:var(--ss-color-error)] p-8 md:p-12 text-center">
              <p class="font-['Archivo'] text-2xl md:text-3xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-error)]">
                Configuration error
              </p>
              <p class="mt-3 font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
                The current configuration projection is invalid. Contact Captain.
              </p>
              <p class="mt-2 font-['JetBrains_Mono'] text-xs text-[color:var(--ss-color-text-muted)] break-all">
                {projectionError}
              </p>
            </div>
          </section>
        ) : editable !== null && locked !== null ? (
          <form
            method="POST"
            action="/api/portal/operator/settings/customer-yaml-update"
            class="mt-2"
          >
            <section class="mt-10 border-[3px] border-[color:var(--ss-color-text-primary)] p-6">
              <h2 class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.18em] font-bold text-[color:var(--ss-color-text-secondary)]">
                Captain-managed identity
              </h2>
              <dl class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                <div>
                  <dt class="font-['Archivo_Narrow'] uppercase tracking-[0.14em] text-xs text-[color:var(--ss-color-text-muted)]">
                    Customer ID
                  </dt>
                  <dd class="font-['JetBrains_Mono'] text-[color:var(--ss-color-text-primary)]">
                    {locked.customer_id}
                  </dd>
                </div>
                <div>
                  <dt class="font-['Archivo_Narrow'] uppercase tracking-[0.14em] text-xs text-[color:var(--ss-color-text-muted)]">
                    Vertical
                  </dt>
                  <dd class="text-[color:var(--ss-color-text-primary)]">{locked.vertical}</dd>
                </div>
                <div>
                  <dt class="font-['Archivo_Narrow'] uppercase tracking-[0.14em] text-xs text-[color:var(--ss-color-text-muted)]">
                    Fly region
                  </dt>
                  <dd class="font-['JetBrains_Mono'] text-[color:var(--ss-color-text-primary)]">
                    {locked.fly_region}
                  </dd>
                </div>
                <div>
                  <dt class="font-['Archivo_Narrow'] uppercase tracking-[0.14em] text-xs text-[color:var(--ss-color-text-muted)]">
                    Model
                  </dt>
                  <dd class="font-['JetBrains_Mono'] text-[color:var(--ss-color-text-primary)]">
                    {locked.model}
                  </dd>
                </div>
                <div>
                  <dt class="font-['Archivo_Narrow'] uppercase tracking-[0.14em] text-xs text-[color:var(--ss-color-text-muted)]">
                    Hermes ref
                  </dt>
                  <dd class="font-['JetBrains_Mono'] text-[color:var(--ss-color-text-primary)]">
                    {locked.hermes_ref}
                  </dd>
                </div>
                <div>
                  <dt class="font-['Archivo_Narrow'] uppercase tracking-[0.14em] text-xs text-[color:var(--ss-color-text-muted)]">
                    Machine
                  </dt>
                  <dd class="font-['JetBrains_Mono'] text-[color:var(--ss-color-text-primary)]">
                    {locked.machine.size} / {locked.machine.memory_mb} MB
                  </dd>
                </div>
              </dl>
              <p class="mt-4 text-xs text-[color:var(--ss-color-text-muted)]">
                Captain-managed fields change only by Captain through the configs repo.
              </p>
            </section>

            <PersonaFields personas={editable.personas} errors={[]} />
            <EscalationFields escalation={editable.escalation} errors={[]} />
            <BusinessHoursFields businessHours={editable.businessHours} errors={[]} />
            <ConnectorsFields
              connectors={editable.connectors}
              tokenRefs={locked.connector_token_refs}
              errors={[]}
            />
            <ScopeFields scope={editable.scope} errors={[]} />

            <div class="mt-12 flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-end border-t-[3px] border-[color:var(--ss-color-text-primary)] pt-6">
              <a
                href={SETTINGS_LANDING_URL}
                class="inline-flex items-center justify-center px-5 py-2 font-['Archivo_Narrow'] uppercase tracking-[0.12em] font-bold text-sm border-[3px] border-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-text-primary)] hover:bg-[color:var(--ss-color-text-primary)] hover:text-[color:var(--ss-color-background)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
              >
                Cancel
              </a>
              <button
                type="submit"
                class="inline-flex items-center justify-center px-5 py-2 font-['Archivo_Narrow'] uppercase tracking-[0.12em] font-bold text-sm border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] hover:bg-[color:var(--ss-color-primary)] hover:border-[color:var(--ss-color-primary)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
              >
                Save changes
              </button>
            </div>
          </form>
        ) : null
      }
    </main>
  </body>
</html>
