/**
 * RETIRED — Operator Configure (console blueprint §5 "what retires";
 * 2026-07-14). The legacy settings-noun page dissolved once the chapters
 * carried its content: skills live on Duties, the authority view carries the
 * exposure posture, voice posture renders on the landing hero, the scope card
 * split into Access (visibility) and People (rosters/blocks), and business
 * hours render on Duties (timezone only, Lock 2). This route stays as a
 * redirect so old bookmarks and links keep working (redirect sources are
 * never deleted).
 */
const instance = Astro.params.instance
if (!instance) return Astro.redirect('/portal/products/operator')
return Astro.redirect(`/portal/products/operator/${instance}`)
