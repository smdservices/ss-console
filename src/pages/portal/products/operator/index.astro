---
import PortalShell from '../../../../layouts/PortalShell.astro'
import { getPortalClient } from '../../../../lib/portal/session'
import { resolvePortalOfferings } from '../../../../lib/portal/offerings'
import { env } from 'cloudflare:workers'

/**
 * Operator product root — the instance chooser (multi-operator model, ADR 0069 +
 * the 2026-07-08 model correction: one client, many operators).
 *
 * This bare path absorbs every legacy inbound link to
 * `/portal/products/operator`. It never renders an operator itself; it routes:
 *   0 operators → honest empty state
 *   1 operator  → redirect straight to that instance's landing
 *   many        → a chooser list, one row per operator the client owns
 *
 * Each operator's real surface lives under `[instance]/`. Instances come from the
 * offerings resolver (subscriptions × configs the client owns); no fabrication.
 */

const portalData = await getPortalClient(env.DB, Astro.locals)
if (!portalData) {
  return Astro.redirect('/auth/sign-in')
}
if (!portalData.client) {
  return Astro.redirect('/auth/sign-in?status=no_subscription')
}
const { client } = portalData

const offerings = await resolvePortalOfferings(env.DB, client.org_id, client.id)
const operators = offerings.operators

// One operator → go straight in; no reason to make the client pick from a list of one.
if (operators.length === 1) {
  return Astro.redirect(`/portal/products/operator/${operators[0].slug}`)
}

const seclabelClass =
  'font-mono text-label font-bold uppercase tracking-[0.14em] text-[color:var(--color-text-secondary)]'
---

<PortalShell
  title="Operator"
  clientName={client.name}
  orgId={client.org_id}
  entityId={client.id}
  pathname={Astro.url.pathname}
>
  <a
    href="/portal"
    class="mt-6 -mx-1 inline-flex min-h-11 items-center gap-2 px-1 font-mono text-label font-semibold uppercase tracking-[0.18em] text-[color:var(--color-text-secondary)] hover:text-[color:var(--color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-action)] focus-visible:ring-offset-2"
  >
    <span aria-hidden="true" class="font-body font-black text-[color:var(--color-primary)]">←</span>
    Home
  </a>

  <p class={`mt-8 ${seclabelClass}`}>Operators</p>

  {
    operators.length === 0 ? (
      <div class="mt-3 border-[3px] border-[color:var(--color-text-primary)] p-8 text-center md:p-12">
        <p class="font-body text-2xl font-black uppercase tracking-[-0.02em] text-[color:var(--color-text-primary)] md:text-3xl">
          No operators yet
        </p>
        <p class="mt-3 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--color-text-secondary)]">
          Your account doesn't include an Operator yet. Contact us if you'd like to talk about
          adding one.
        </p>
      </div>
    ) : (
      <div class="mt-3 border-[3px] border-[color:var(--color-text-primary)] bg-[color:var(--color-background)]">
        {operators.map((op, i) => (
          <a
            href={`/portal/products/operator/${op.slug}`}
            class={`group flex items-center justify-between gap-6 px-5 py-5 transition-colors hover:bg-[color:var(--color-border-subtle)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-action)] focus-visible:ring-inset md:px-7 ${
              i > 0 ? 'border-t-[2px] border-[color:var(--color-border)]' : ''
            }`}
          >
            <div class="min-w-0">
              <p class="font-body text-lg font-black uppercase tracking-[-0.01em] text-[color:var(--color-text-primary)]">
                {op.displayName}
              </p>
              <p class="mt-0.5 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--color-text-secondary)]">
                {op.role ? `${op.role} · ` : ''}
                {op.status}
              </p>
            </div>
            <span
              aria-hidden="true"
              class="font-body font-black text-[color:var(--color-primary)] transition-transform group-hover:translate-x-1"
            >
              →
            </span>
          </a>
        ))}
      </div>
    )
  }
</PortalShell>
