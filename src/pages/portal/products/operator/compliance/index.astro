---
import { GOOGLE_FONTS_URL } from '../../../../../lib/fonts'
import '../../../../../styles/global.css'
import { BRAND_NAME } from '../../../../../lib/config/brand'
import {
  resolveOperatorAccess,
  OPERATOR_LANDING_PATH,
} from '../../../../../lib/portal/operator-access'
import { getCustomerConfig } from '../../../../../lib/portal/customer-config'
import {
  resolveComplianceView,
  formatRetentionWindow,
} from '../../../../../lib/portal/operator/compliance'
import type { Vertical } from '../../../../../lib/operator/customer-yaml'
import { ACCEPTED_VERTICALS } from '../../../../../lib/operator/customer-yaml'
import PortalHeader from '../../../../../components/portal/PortalHeader.astro'
import PortalTabs from '../../../../../components/portal/PortalTabs.astro'
import PortalPageHead from '../../../../../components/portal/PortalPageHead.astro'
import SkipToMain from '../../../../../components/SkipToMain.astro'
import { env } from 'cloudflare:workers'

/**
 * Operator — Compliance dashboard view.
 *
 * URL: portal.smd.services/portal/products/operator/compliance
 *
 * Per issue #895 + docs/specs/operator/dashboard-roles.md. This is
 * the dedicated separation-of-duties surface for the `compliance` role:
 * audit log entry, evidence packet generation entry, and a read-only
 * view of the firm's audit retention posture. Operator-facing
 * workflow surfaces are intentionally absent; the compliance
 * reviewer's job is the firm's history and posture, not day-to-day
 * workflow.
 *
 * Access gate:
 *   - Clerk session (middleware)
 *   - Local entity bound to the active Clerk organization
 *   - Active Operator subscription on this customer
 *   - Caller holds principal OR compliance role (operators redirect)
 *
 * Opt-in gate (`compliance_enabled` on customer.yaml):
 *   - When false (the default), this view renders an explicit empty
 *     state explaining the firm hasn't opted in. RBAC on the existing
 *     audit surface is unaffected — compliance-role users can still
 *     view the governance log directly at /portal/products/operator/activity
 *     even when this dedicated view is disabled. The view is the
 *     surface, not the gate; the gate is product_roles.
 *   - When true, the controls render.
 *
 * Retention posture:
 *   - Read-only. Mutation lives in principal-only Settings (audit
 *     retention is a memory.retention.* field on customer.yaml, and
 *     customer.yaml lives in git). This view shows what is currently
 *     in effect so compliance reviewers can confirm the firm's
 *     posture without principal credentials.
 *   - Today the value displayed is the per-vertical default since the
 *     `memory.retention.audit_log_days` override is not yet projected
 *     into customer_configs. When that projection lands, the resolver
 *     surfaces both the default and the override; the view branches
 *     here without code changes (see compliance.ts).
 *
 * Evidence packet generation:
 *   - The packet itself is generated by the `compliance-audit-export`
 *     skill on the per-customer Hermes Machine (see
 *     docs/specs/operator/compliance-evidence-packet.md). The
 *     portal-side trigger UI is a follow-on (#878); this surface
 *     ships the entry point as a disabled-state card with an honest
 *     explanation per docs/style/empty-state-pattern.md so the
 *     placement contract is stable when the trigger lands.
 */

const access = await resolveOperatorAccess(env.DB, Astro.locals, {
  allowedRoles: ['principal', 'compliance'],
})
if (access.kind === 'redirect') {
  return Astro.redirect(access.to)
}
const { client, roles } = access

const hasComplianceViewRole = roles.includes('principal') || roles.includes('compliance')
if (!hasComplianceViewRole) {
  return Astro.redirect(OPERATOR_LANDING_PATH)
}

const config = await getCustomerConfig(env.DB, client.id)
const complianceEnabled = config?.compliance_enabled ?? false
const rawVertical = config?.vertical ?? null
const vertical: Vertical | null = (() => {
  if (rawVertical === null) return null
  return (ACCEPTED_VERTICALS as readonly string[]).includes(rawVertical)
    ? (rawVertical as Vertical)
    : null
})()

const view = resolveComplianceView({
  complianceEnabled,
  vertical,
  // The customer.yaml.memory.retention.audit_log_days override is not
  // yet projected into customer_configs (out of scope for #895). Pass
  // null so the view falls back to the vertical default — honest,
  // no fabrication. When the projection lands, swap this for
  // config?.memory_retention?.audit_log_days ?? null.
  auditLogDaysOverride: null,
  callerRoles: roles,
})

const isPrincipalOnly = roles.includes('principal') && !roles.includes('compliance')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href={GOOGLE_FONTS_URL} rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <title>Operator · Compliance | {BRAND_NAME}</title>
  </head>
  <body class="min-h-screen bg-[color:var(--ss-color-background)]">
    <SkipToMain />
    <PortalHeader clientName={client.name} />

    <PortalTabs pathname={Astro.url.pathname} operatorActive={true} />

    <main id="main" role="main" class="max-w-5xl mx-auto px-4 md:px-6 pb-24 md:pb-12">
      <PortalPageHead
        crumbHref="/portal/products/operator"
        crumbLabel="Operator"
        tag="Section"
        h1="Compliance"
        meta={null}
      />

      {
        !view.enabled && (
          <section
            aria-label="Compliance view not enabled"
            class="mt-8 border-[3px] border-[color:var(--ss-color-text-primary)] p-8 md:p-12 text-center"
          >
            <p class="font-body text-2xl md:text-3xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]">
              Compliance view not enabled
            </p>
            <p class="mt-3 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
              This firm has not opted in to the dedicated Compliance dashboard. The audit log is
              still available directly to authorized roles.
            </p>
            <p class="mt-6 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
              <a
                href="/portal/products/operator/activity"
                class="underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 rounded"
              >
                Go to audit log
              </a>
            </p>
          </section>
        )
      }

      {
        view.enabled && (
          <div class="mt-8 flex flex-col gap-8">
            {isPrincipalOnly && (
              <section
                aria-label="Principal read-only notice"
                class="border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-background)] p-5 md:p-6"
              >
                <p class="font-mono text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-primary)]">
                  Read-only view
                </p>
                <p class="mt-2 text-sm text-[color:var(--ss-color-text-secondary)]">
                  This is the same dashboard your compliance reviewer sees. Retention controls are
                  configured in Settings.
                </p>
              </section>
            )}

            <section
              aria-label="Audit log"
              class="border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-background)]"
            >
              <div class="bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] px-5 py-2.5 font-mono text-label uppercase tracking-[0.18em] font-bold">
                Audit log
              </div>
              <div class="px-5 md:px-7 py-6">
                <p class="text-sm text-[color:var(--ss-color-text-secondary)]">
                  Every safety-relevant action the Operator takes is recorded with a timestamp,
                  actor, and decision. That covers drafts created, sends approved, identity changes,
                  memory access, and connector binding.
                </p>
                <p class="mt-4">
                  <a
                    href="/portal/products/operator/activity"
                    class="inline-flex items-center min-h-11 px-4 py-2 border-[3px] border-[color:var(--ss-color-text-primary)] font-mono text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-primary)] hover:bg-[color:var(--ss-color-text-primary)] hover:text-[color:var(--ss-color-background)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
                  >
                    Open audit log
                  </a>
                </p>
              </div>
            </section>

            <section
              aria-label="Audit retention"
              class="border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-background)]"
            >
              <div class="bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] px-5 py-2.5 font-mono text-label uppercase tracking-[0.18em] font-bold">
                Audit retention
              </div>
              <div class="px-5 md:px-7 py-6">
                {view.retention === null ? (
                  <p class="text-sm text-[color:var(--ss-color-text-secondary)]">
                    Retention posture is not yet on file for this firm.
                  </p>
                ) : (
                  <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
                    <div>
                      <dt class="font-mono text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]">
                        Vertical
                      </dt>
                      <dd class="mt-1 font-body text-base text-[color:var(--ss-color-text-primary)]">
                        {view.retention.vertical}
                      </dd>
                    </div>
                    <div>
                      <dt class="font-mono text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]">
                        Effective retention window
                      </dt>
                      <dd class="mt-1 font-body text-base text-[color:var(--ss-color-text-primary)]">
                        {formatRetentionWindow(view.retention.effectiveDays)}
                      </dd>
                    </div>
                    <div>
                      <dt class="font-mono text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]">
                        Per-vertical default
                      </dt>
                      <dd class="mt-1 font-body text-base text-[color:var(--ss-color-text-primary)]">
                        {formatRetentionWindow(view.retention.defaultDays)}
                      </dd>
                    </div>
                    <div>
                      <dt class="font-mono text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]">
                        Firm override
                      </dt>
                      <dd class="mt-1 font-body text-base text-[color:var(--ss-color-text-primary)]">
                        {view.retention.overrideDays === null
                          ? 'None (default applies)'
                          : formatRetentionWindow(view.retention.overrideDays)}
                      </dd>
                    </div>
                  </dl>
                )}
              </div>
            </section>

            <section
              aria-label="Evidence packet"
              class="border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-background)]"
            >
              <div class="bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] px-5 py-2.5 font-mono text-label uppercase tracking-[0.18em] font-bold">
                Evidence packet
              </div>
              <div class="px-5 md:px-7 py-6">
                <p class="text-sm text-[color:var(--ss-color-text-secondary)]">
                  A signed, reviewer-readable archive documenting how the Operator operated inside
                  this organization during a chosen window: plain-language summary, structured audit
                  log, redacted configuration, signed addenda.
                </p>
                <p class="mt-4 font-mono text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]">
                  Generation runs on the per-firm machine. The portal trigger lands separately;
                  contact your principal to request a packet today.
                </p>
              </div>
            </section>
          </div>
        )
      }
    </main>
  </body>
</html>
