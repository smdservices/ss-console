---
import '../../../../../styles/global.css'
import { BRAND_NAME } from '../../../../../lib/config/brand'
import { resolveAiEmployeeAccess } from '../../../../../lib/portal/ai-employee-access'
import PortalHeader from '../../../../../components/portal/PortalHeader.astro'
import PortalTabs from '../../../../../components/portal/PortalTabs.astro'
import PortalPageHead from '../../../../../components/portal/PortalPageHead.astro'
import SkipToMain from '../../../../../components/SkipToMain.astro'
import { SignOutButton } from '@clerk/astro/components'
import { env } from 'cloudflare:workers'
import {
  formatNotificationType,
  NOTIFICATION_TYPES,
  type NotificationType,
} from '../../../../../lib/portal/ai-employee/notifications'
import {
  listNotificationPrefs,
  PREF_SCOPES,
  type PrefScope,
} from '../../../../../lib/portal/ai-employee/notification-prefs'

/**
 * AI Employee — Notification preferences (per-user, self-service).
 *
 * URL: portal.smd.services/portal/products/ai-employee/settings/notifications
 *
 * Per #882, multi-paralegal firms need per-user notification routing
 * rules so the AI Employee doesn't notify everyone for everything.  A
 * user picks which event types they want to hear about, and at what
 * scope:
 *
 *   - `mine` — only matters this user is currently assigned to
 *   - `all`  — every matter on the firm
 *
 * The form is one checkbox per (event_type, scope) pair.  A user with
 * NO checked boxes opts out of every notification — they're trusting
 * the firm-wide "all" subscribers to act on their behalf.  A user with
 * NO row in the table at all (never visited this page) gets the
 * default routing (every event, every matter) per the resolver in
 * notification-prefs.ts.
 *
 * The page seeds the form from the user's current preference set.  The
 * "default routing" affordance (show every box checked for a user who
 * has never saved) is a UX nicety we intentionally skip — the form
 * surfaces the actual current state.  A first-time visitor sees every
 * box unchecked but with the prose note "You currently receive every
 * notification.  Save below to switch to opt-in routing."
 *
 * Access gate:
 *   - Clerk session (middleware)
 *   - Local entity bound to the active Clerk organization
 *   - Active AI Employee subscription on this customer
 *   - Caller holds principal OR operator OR compliance role
 *
 * Mutations are HTML-form POSTs to
 * `/api/portal/products/ai-employee/notification-prefs`.  Replace-
 * semantics: the form sends every desired pref; the endpoint deletes
 * old rows and inserts new ones in one shot.  Emits one
 * `audit:rbac_event` per save with the post-write snapshot.
 */

const access = await resolveAiEmployeeAccess(env.DB, Astro.locals, {
  allowedRoles: ['principal', 'operator', 'compliance'],
})
if (access.kind === 'redirect') {
  return Astro.redirect(access.to)
}
const { client, user } = access

const currentPrefs = await listNotificationPrefs(env.DB, client.id, user.id)
const checkedKeys = new Set(currentPrefs.map((p) => `${p.eventType}:${p.scope}`))
const hasAnyPref = currentPrefs.length > 0

const status = Astro.url.searchParams.get('status')
type BannerStatus = { text: string; tone: 'success' | 'error' | 'info' }
const STATUS_BANNERS: Record<string, BannerStatus> = {
  prefs_saved: { text: 'Notification preferences saved.', tone: 'success' },
}
const banner = status ? (STATUS_BANNERS[status] ?? null) : null

interface RowSpec {
  eventType: NotificationType
  label: string
  description: string
}
const ROW_DESCRIPTIONS: Record<NotificationType, string> = {
  draft_ready: 'A new draft is waiting for review.',
  error: 'A connector dropped out, a fabrication filter fired, or another error needs attention.',
  calibration_prompt: 'The AI Employee is asking for confirmation on a behavior change.',
  weekly_digest: 'The weekly activity rollup for your firm.',
}
const rows: RowSpec[] = NOTIFICATION_TYPES.map((eventType) => ({
  eventType,
  label: formatNotificationType(eventType),
  description: ROW_DESCRIPTIONS[eventType],
}))

const SCOPE_LABEL: Record<PrefScope, string> = {
  mine: 'My matters',
  all: 'All matters',
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;900&family=Archivo+Narrow:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <title>AI Employee · Notifications | {BRAND_NAME}</title>
  </head>
  <body class="min-h-screen bg-[color:var(--ss-color-background)]">
    <SkipToMain />
    <PortalHeader clientName={client.name}>
      <SignOutButton asChild redirectUrl="/auth/portal-sign-in?status=signed_out">
        <button
          type="button"
          class="inline-flex items-center min-h-11 px-2 -mx-2 text-sm text-[color:var(--ss-color-text-muted)] hover:text-[color:var(--ss-color-text-primary)] active:text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 rounded transition-colors"
        >
          Sign out
        </button>
      </SignOutButton>
    </PortalHeader>

    <PortalTabs pathname={Astro.url.pathname} aiEmployeeActive={true} />

    <main id="main" role="main" class="max-w-5xl mx-auto px-4 md:px-6 pb-24 md:pb-12">
      <PortalPageHead
        crumbHref="/portal/products/ai-employee"
        crumbLabel="AI Employee"
        tag="Settings"
        h1="Notifications"
        meta={null}
      />

      {
        banner && (
          <div
            role="status"
            class:list={[
              'mt-6 px-4 py-3 border-[3px] text-sm',
              banner.tone === 'success'
                ? 'border-[color:var(--ss-color-complete)] bg-[color:var(--ss-color-complete)]/10 text-[color:var(--ss-color-complete)]'
                : 'border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-border-subtle)] text-[color:var(--ss-color-text-primary)]',
            ]}
          >
            {banner.text}
          </div>
        )
      }

      {
        !hasAnyPref && (
          <div class="mt-8 border-[3px] border-[color:var(--ss-color-text-primary)] p-6">
            <p class="font-['Archivo'] font-bold text-[color:var(--ss-color-text-primary)]">
              You currently receive every notification
            </p>
            <p class="mt-2 text-sm text-[color:var(--ss-color-text-secondary)]">
              You haven't set per-user notification preferences yet, so you receive every event for
              every matter. Pick which events to receive below and save to switch to opt-in routing.
            </p>
          </div>
        )
      }

      <form method="POST" action="/api/portal/products/ai-employee/notification-prefs" class="mt-8">
        <div class="border-[3px] border-[color:var(--ss-color-text-primary)]">
          <div
            class="hidden md:grid md:grid-cols-[1fr_140px_140px] gap-4 px-5 py-3 bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold"
            aria-hidden="true"
          >
            <span>Event</span>
            <span class="text-center">{SCOPE_LABEL.mine}</span>
            <span class="text-center">{SCOPE_LABEL.all}</span>
          </div>

          {
            rows.map((row, idx) => (
              <div
                class:list={[
                  'px-5 py-4 md:grid md:grid-cols-[1fr_140px_140px] md:items-center md:gap-4',
                  idx > 0 ? 'border-t-[2px] border-[color:var(--ss-color-text-primary)]' : '',
                ]}
              >
                <div class="flex flex-col gap-1">
                  <span class="font-['Archivo'] font-bold text-[color:var(--ss-color-text-primary)]">
                    {row.label}
                  </span>
                  <span class="text-xs text-[color:var(--ss-color-text-secondary)]">
                    {row.description}
                  </span>
                </div>

                {PREF_SCOPES.map((scope) => {
                  const key = `${row.eventType}:${scope}`
                  const isChecked = checkedKeys.has(key)
                  return (
                    <label class="flex items-center justify-start md:justify-center gap-2 mt-3 md:mt-0">
                      <span class="md:sr-only font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)] font-semibold">
                        {SCOPE_LABEL[scope]}
                      </span>
                      <input
                        type="checkbox"
                        name={`pref:${row.eventType}:${scope}`}
                        value="1"
                        checked={isChecked}
                        class="h-5 w-5 border-[2px] border-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
                      />
                    </label>
                  )
                })}
              </div>
            ))
          }
        </div>

        <div class="mt-6 flex flex-col sm:flex-row items-start sm:items-center gap-3">
          <button
            type="submit"
            class="inline-flex items-center justify-center px-5 py-2 font-['Archivo_Narrow'] uppercase tracking-[0.12em] font-bold text-sm border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] hover:bg-[color:var(--ss-color-primary)] hover:border-[color:var(--ss-color-primary)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
          >
            Save preferences
          </button>
          <p class="text-xs text-[color:var(--ss-color-text-muted)]">
            Saving with every box unchecked opts you out of all notifications. Your matters still
            route to you for action; you just won't get the alert.
          </p>
        </div>
      </form>
    </main>
  </body>
</html>
