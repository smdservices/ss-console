---
import '../../../../../styles/global.css'
import { BRAND_NAME } from '../../../../../lib/config/brand'
import { resolveAiEmployeeAccess } from '../../../../../lib/portal/ai-employee-access'
import { loadSettingsView } from '../../../../../lib/portal/ai-employee/settings'
import PortalHeader from '../../../../../components/portal/PortalHeader.astro'
import PortalTabs from '../../../../../components/portal/PortalTabs.astro'
import PortalPageHead from '../../../../../components/portal/PortalPageHead.astro'
import SkipToMain from '../../../../../components/SkipToMain.astro'
import TrustCeilingSection from '../../../../../components/portal/ai-employee/TrustCeilingSection.astro'
import VoiceSamplesSection from '../../../../../components/portal/ai-employee/VoiceSamplesSection.astro'
import SkillTogglesSection from '../../../../../components/portal/ai-employee/SkillTogglesSection.astro'
import ConnectorStatusSection from '../../../../../components/portal/ai-employee/ConnectorStatusSection.astro'
import { env } from 'cloudflare:workers'

/**
 * AI Employee — Settings (principal-only).
 *
 * URL: portal.smd.services/portal/products/ai-employee/settings
 *
 * Four working sections per issue #874:
 *   1. Trust ceiling controls per skill
 *   2. Voice sample management (view / add / remove)
 *   3. Skill toggles (enable / disable per skill)
 *   4. Connector status + re-consent paths
 *
 * The optional `customer.yaml` editor UI from #874 ACs is tracked
 * separately as #877; this page links to it (the route may 404
 * until #877 lands; the link is the contract).
 *
 * Access gate (principal-only — operators and compliance are
 * redirected to the AI Employee landing):
 *   - Clerk session (middleware)
 *   - Local entity bound to the active Clerk organization
 *   - Active AI Employee subscription on this customer
 *   - Caller holds the `principal` role
 *
 * Data sources:
 *   - customer.yaml projection in `customer_configs` (D1) for
 *     trust ceiling rows, skill toggles, and connector list
 *   - Voice samples and live connector health are bound to
 *     subsystems not yet portal-wired (Hermes voice pipeline,
 *     conformance harness). Both render an empty list today per
 *     docs/style/empty-state-pattern.md.
 *
 * Mutations are HTML-form POSTs to the per-section endpoints
 * under /api/portal/ai-employee/settings/*. Each endpoint logs
 * intent today; real propagation to customer.yaml lands once
 * the configs-repo write path ships. The page surfaces a
 * confirmation banner on `?status=ack` per UI-PATTERNS R1.
 */

const access = await resolveAiEmployeeAccess(env.DB, Astro.locals, {
  allowedRoles: ['principal'],
})
if (access.kind === 'redirect') {
  return Astro.redirect(access.to)
}
const { client } = access

const view = await loadSettingsView(env.DB, client.id)

// Confirmation banner. We treat every ack-like status as a single
// success banner; specific error values surface their own copy. No
// status param → no banner.
const statusParam = Astro.url.searchParams.get('status')
const banner: { kind: 'ok' | 'error'; text: string } | null = (() => {
  if (statusParam === null) return null
  switch (statusParam) {
    case 'ack':
      return { kind: 'ok', text: 'Saved.' }
    case 'voice_added':
      return { kind: 'ok', text: 'Voice sample queued.' }
    case 'voice_removed':
      return { kind: 'ok', text: 'Voice sample removed.' }
    case 'reconsent_started':
      return { kind: 'ok', text: 'Re-authorization started.' }
    case 'invalid_skill':
      return { kind: 'error', text: 'That skill is not configured.' }
    case 'invalid_level':
      return { kind: 'error', text: 'That trust ceiling is not valid.' }
    case 'invalid_state':
      return { kind: 'error', text: 'That toggle value is not valid.' }
    case 'invalid_sample':
      return { kind: 'error', text: 'That voice sample is not valid.' }
    case 'invalid_capability':
      return { kind: 'error', text: 'That connector is not configured.' }
    case 'invalid_action':
      return { kind: 'error', text: 'That action is not valid.' }
    default:
      return null
  }
})()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;900&family=Archivo+Narrow:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <title>AI Employee · Settings | {BRAND_NAME}</title>
  </head>
  <body class="min-h-screen bg-[color:var(--ss-color-background)]">
    <SkipToMain />
    <PortalHeader clientName={client.name} />

    <PortalTabs pathname={Astro.url.pathname} aiEmployeeActive={true} />

    <main id="main" role="main" class="max-w-5xl mx-auto px-4 md:px-6 pb-24 md:pb-12">
      <PortalPageHead
        crumbHref="/portal/products/ai-employee"
        crumbLabel="AI Employee"
        tag="Section"
        h1="Settings"
        meta={null}
      />

      {
        banner ? (
          <div
            role="status"
            aria-live="polite"
            class={`mt-stack border-[3px] p-card ${
              banner.kind === 'ok'
                ? 'border-[color:var(--ss-color-text-primary)]'
                : 'border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-border-subtle)]'
            }`}
          >
            <p class="text-body text-[color:var(--ss-color-text-primary)] m-0">{banner.text}</p>
          </div>
        ) : null
      }

      <div class="mt-section flex items-baseline justify-between gap-4 flex-wrap">
        <p class="text-caption text-[color:var(--ss-color-text-secondary)] m-0">
          Settings affect every user on your account. Only principals see this page.
        </p>
        <a
          href="/portal/products/ai-employee/settings/users"
          class="inline-flex items-center gap-2 min-h-11 font-['Archivo_Narrow'] text-xs md:text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--ss-color-primary)] hover:text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
        >
          Users
          <span aria-hidden="true" class="font-['Archivo'] font-black">→</span>
        </a>
      </div>

      <TrustCeilingSection rows={view.trustCeilingRows} personaSlug={view.personaSlug} />

      <VoiceSamplesSection samples={view.voiceSamples} />

      <SkillTogglesSection rows={view.skillToggleRows} personaSlug={view.personaSlug} />

      <ConnectorStatusSection rows={view.connectorRows} />
    </main>
  </body>
</html>
