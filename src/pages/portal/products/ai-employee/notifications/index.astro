---
import '../../../../../styles/global.css'
import { BRAND_NAME } from '../../../../../lib/config/brand'
import { resolveAiEmployeeAccess } from '../../../../../lib/portal/ai-employee-access'
import {
  countUnread,
  listNotifications,
  NOTIFICATION_SORTS,
  NOTIFICATION_TYPES,
  formatNotificationType,
  parseNotificationListParams,
  type NotificationType,
} from '../../../../../lib/portal/ai-employee/notifications'
import PortalHeader from '../../../../../components/portal/PortalHeader.astro'
import PortalTabs from '../../../../../components/portal/PortalTabs.astro'
import PortalPageHead from '../../../../../components/portal/PortalPageHead.astro'
import SkipToMain from '../../../../../components/SkipToMain.astro'
import NotificationBell from '../../../../../components/portal/ai-employee/NotificationBell.astro'
import NotificationRow from '../../../../../components/portal/ai-employee/NotificationRow.astro'
import { SignOutButton } from '@clerk/astro/components'
import { env } from 'cloudflare:workers'

/**
 * AI Employee — In-app notifications list (#876).
 *
 * URL: portal.smd.services/portal/products/ai-employee/notifications
 *
 * Per the issue, customers need to be alerted when something happens
 * inside the AI Employee surface: a draft is ready for review, an
 * error needs attention, a calibration prompt is waiting, or the
 * weekly digest landed. This page is the in-app surface for those
 * events.
 *
 * Data source: per-customer Hermes Machine D1 (ADR 0007 + 0009),
 * filtered down to notification-eligible events from the audit_log
 * writer plus future first-class notification rows. The portal
 * Worker cannot bind directly to a per-customer D1; the read path is
 * pending Hermes runtime wiring (#821). Until that bridge ships,
 * `listNotifications` returns an empty list with the correct typed
 * shape — the page renders the empty state per
 * docs/style/empty-state-pattern.md, no fabricated rows, no fake
 * counts, no "coming soon" copy.
 *
 * Filter / sort / pagination machinery is wired today so the URL
 * contract is stable when the bridge lands.
 *
 * Header integration: the issue's AC calls for a bell icon in the
 * shared portal header. The shared `PortalHeader.astro` is OUT of
 * file scope for this PR (changing it would touch every portal
 * surface). The bell is rendered at the top of this dedicated
 * /notifications page instead so the component, badge math, and
 * mark-read flow are all exercised end-to-end. Header integration is
 * filed as a follow-on issue and called out in the PR body.
 *
 * Email digest: the issue marks the email digest as Optional. It is
 * deferred to a follow-on issue per the issue contract and not
 * blocking this PR.
 *
 * Access gate (see resolveAiEmployeeAccess):
 *   - Clerk session (middleware)
 *   - Local entity bound to the active Clerk organization
 *   - Active AI Employee subscription on this customer
 *   - Caller holds principal, operator, OR compliance role (all three
 *     get notifications; principals see calibration prompts they own,
 *     operators see draft-ready events on their queue, compliance see
 *     errors and digests on their watch)
 */

const access = await resolveAiEmployeeAccess(env.DB, Astro.locals, {
  allowedRoles: ['principal', 'operator', 'compliance'],
})
if (access.kind === 'redirect') {
  return Astro.redirect(access.to)
}
const { client, subscription } = access

const params = parseNotificationListParams(Astro.url.searchParams)
const notificationsPage = await listNotifications(subscription, params)

// Unread count is over the FULL list, not the filtered subset — the
// bell badge always reflects what the customer needs to act on, not
// what the current view is showing. listNotifications returns []
// today, so this is 0. When the bridge lands and the customer wants
// counts independent of pagination, a separate summary fetch will
// replace this count.
const unreadCount = countUnread(notificationsPage.rows)

// The marked=N URL param carries the count of rows the mark-all-read
// endpoint flipped, surfaced as a small confirmation banner.
const markedParamRaw = Astro.url.searchParams.get('marked')
const markedCount =
  markedParamRaw !== null && /^\d+$/.test(markedParamRaw) ? Number(markedParamRaw) : null

// The page builds its own filter chrome inline. The form is simple
// enough (type multi-select + unread-only checkbox + sort) that an
// extracted FilterBar component would obscure more than it deduplicates.
// Drafts and audit have dedicated filter bars because their filter
// vocabularies are wider; this surface is intentionally narrow.
const selectedTypes: ReadonlySet<NotificationType> = new Set(params.types)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;900&family=Archivo+Narrow:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <title>AI Employee · Notifications | {BRAND_NAME}</title>
  </head>
  <body class="min-h-screen bg-[color:var(--ss-color-background)]">
    <SkipToMain />
    <PortalHeader clientName={client.name}>
      <SignOutButton asChild redirectUrl="/auth/sign-in?status=signed_out">
        <button
          type="button"
          class="inline-flex items-center min-h-11 px-2 -mx-2 text-sm text-[color:var(--ss-color-text-muted)] hover:text-[color:var(--ss-color-text-primary)] active:text-[color:var(--ss-color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 rounded transition-colors"
        >
          Sign out
        </button>
      </SignOutButton>
    </PortalHeader>

    <PortalTabs pathname={Astro.url.pathname} aiEmployeeActive={true} />

    <main id="main" role="main" class="max-w-5xl mx-auto px-4 md:px-6 pb-24 md:pb-12">
      <PortalPageHead
        crumbHref="/portal/products/ai-employee"
        crumbLabel="AI Employee"
        tag="Section"
        h1="Notifications"
        meta={notificationsPage.totalCount > 0 ? `${notificationsPage.totalCount} total` : null}
      />

      <div class="mt-8 flex flex-col gap-6">
        {
          /* Bell + mark-all-read affordance row. The bell is rendered
            here (instead of the shared header) per the file-scope
            note in the page docstring. */
        }
        <div class="flex items-center justify-between gap-3 flex-wrap">
          <div class="flex items-center gap-3">
            <NotificationBell unreadCount={unreadCount} />
            <p
              class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]"
            >
              {unreadCount === 0 ? 'No unread notifications' : `${unreadCount} unread`}
            </p>
          </div>
          {
            unreadCount > 0 && (
              <form
                method="POST"
                action="/api/portal/ai-employee/notifications/mark-all-read"
                class="contents"
              >
                <input
                  type="hidden"
                  name="returnTo"
                  value="/portal/products/ai-employee/notifications"
                />
                <button
                  type="submit"
                  class="inline-flex items-center min-h-11 px-4 py-2 border-[2px] border-[color:var(--ss-color-text-primary)] font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-primary)] hover:bg-[color:var(--ss-color-border-subtle)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 transition-colors"
                >
                  Mark all read
                </button>
              </form>
            )
          }
        </div>

        {
          /* Mark-all confirmation banner. Renders only when the
            mark-all-read endpoint just ran and reported >0 rows
            flipped. Empty today (bridge stub returns 0) but the
            contract is wired so reviewers see the surface behavior
            end-to-end. */
        }
        {
          markedCount !== null && markedCount > 0 && (
            <p
              role="status"
              class="border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-border-subtle)] px-4 py-3 font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-primary)]"
            >
              Marked {markedCount} {markedCount === 1 ? 'notification' : 'notifications'} read
            </p>
          )
        }

        {
          /* Filter form. GET so back/forward and bookmarks reflect the
            current view. No JS — submission is a plain page navigate. */
        }
        <form
          method="GET"
          action="/portal/products/ai-employee/notifications"
          class="border-[3px] border-[color:var(--ss-color-text-primary)] p-5 flex flex-col gap-5"
        >
          <fieldset class="flex flex-col gap-3">
            <legend
              class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]"
            >
              Type
            </legend>
            <div class="flex flex-wrap gap-3">
              {
                NOTIFICATION_TYPES.map((type) => (
                  <label class="inline-flex items-center gap-2 cursor-pointer min-h-11">
                    <input
                      type="checkbox"
                      name="type"
                      value={type}
                      checked={selectedTypes.has(type)}
                      class="w-4 h-4 accent-[color:var(--ss-color-action)]"
                    />
                    <span class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-primary)]">
                      {formatNotificationType(type)}
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="flex flex-wrap items-end gap-5">
            <label class="inline-flex items-center gap-2 cursor-pointer min-h-11">
              <input
                type="checkbox"
                name="unread"
                value="1"
                checked={params.unreadOnly}
                class="w-4 h-4 accent-[color:var(--ss-color-action)]"
              />
              <span
                class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-semibold text-[color:var(--ss-color-text-primary)]"
              >
                Unread only
              </span>
            </label>

            <label class="flex flex-col gap-1">
              <span
                class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]"
              >
                Sort
              </span>
              <select
                name="sort"
                class="min-h-11 px-3 py-2 border-[2px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-surface)] font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-semibold text-[color:var(--ss-color-text-primary)]"
              >
                {
                  NOTIFICATION_SORTS.map((sort) => (
                    <option value={sort} selected={params.sort === sort}>
                      {sort === 'ts_desc' ? 'Newest first' : 'Oldest first'}
                    </option>
                  ))
                }
              </select>
            </label>

            <div class="ml-auto flex items-center gap-3">
              <button
                type="submit"
                class="inline-flex items-center min-h-11 px-4 py-2 bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-primary)] font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold hover:bg-[color:var(--ss-color-action)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 transition-colors"
              >
                Apply filters
              </button>
              <a
                href="/portal/products/ai-employee/notifications"
                class="inline-flex items-center min-h-11 px-3 py-2 font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-primary)] hover:text-[color:var(--ss-color-action)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2 transition-colors"
              >
                Reset
              </a>
            </div>
          </div>
        </form>

        {
          notificationsPage.totalCount === 0 ? (
            <section
              aria-label="No notifications"
              class="border-[3px] border-[color:var(--ss-color-text-primary)] p-8 md:p-12 text-center"
            >
              <p class="font-['Archivo'] text-2xl md:text-3xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]">
                No notifications yet
              </p>
              <p class="mt-3 font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
                Alerts about new drafts, errors, and calibration prompts will land here.
              </p>
            </section>
          ) : (
            <section aria-label="Notifications">
              <div class="border-[3px] border-[color:var(--ss-color-text-primary)]">
                {notificationsPage.rows.map((notification, index) => (
                  <NotificationRow
                    notification={notification}
                    serial={String(
                      index + 1 + (notificationsPage.page - 1) * notificationsPage.pageSize
                    ).padStart(2, '0')}
                  />
                ))}
              </div>

              {notificationsPage.pageCount > 1 && (
                <nav
                  aria-label="Notifications pagination"
                  class="mt-4 flex flex-col md:flex-row md:items-center md:justify-between gap-3"
                >
                  <p class="font-['Archivo_Narrow'] text-label uppercase tracking-[0.14em] font-bold text-[color:var(--ss-color-text-secondary)]">
                    Page {notificationsPage.page} of {notificationsPage.pageCount}
                  </p>
                </nav>
              )}
            </section>
          )
        }
      </div>
    </main>
  </body>
</html>
