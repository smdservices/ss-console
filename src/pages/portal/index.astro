---
import { getPortalClient } from '../../lib/portal/session'
import {
  loadPortalHomeDashboard,
  type PortalHomeEngagement,
  type PortalHomeInvoice,
  type PortalHomeQuote,
  type PortalHomeMilestone,
} from '../../lib/portal/home'
import { resolvePortalOfferings } from '../../lib/portal/offerings'
import { loadHomeCards, type OfferingCard } from '../../lib/portal/home-cards'
import PortalShell from '../../layouts/PortalShell.astro'
import PortalPageHead from '../../components/portal/PortalPageHead.astro'
import HomeOfferingCard from '../../components/portal/HomeOfferingCard.astro'
import TimelineEntry from '../../components/portal/TimelineEntry.astro'
import { env } from 'cloudflare:workers'

/**
 * Portal home — the status dashboard (portal IA rebuild, Captain decision
 * 3): one card per owned offering with its live status and what needs the
 * client now, then the recent-activity log. An entity that owns nothing
 * yet gets the warm holding page (decision 11) — who we are, workspace
 * ready, contact affordances in the header — never a fake dashboard.
 */

export const prerender = false

const portalData = await getPortalClient(env.DB, Astro.locals)
if (!portalData) {
  return Astro.redirect('/auth/sign-in')
}
if (!portalData.client) {
  return Astro.redirect('/auth/sign-in?status=no_subscription')
}
const { user, client } = portalData

let dashboardError = false
let cards: OfferingCard[] = []
let activeEngagement: PortalHomeEngagement | null = null
let invoices: PortalHomeInvoice[] = []
let quotes: PortalHomeQuote[] = []
let completedMilestones: PortalHomeMilestone[] = []

const offerings = await resolvePortalOfferings(env.DB, user.org_id, client.id).catch(() => null)
if (!offerings) {
  dashboardError = true
}

if (offerings) {
  try {
    const [loadedCards, dashboard] = await Promise.all([
      loadHomeCards(env.DB, {
        orgId: user.org_id,
        entityId: client.id,
        userId: user.id,
        offerings,
      }),
      loadPortalHomeDashboard(env.DB, user.org_id, client.id),
    ])
    cards = loadedCards
    activeEngagement = dashboard.activeEngagement
    invoices = dashboard.invoices
    quotes = dashboard.quotes
    completedMilestones = dashboard.completedMilestones
  } catch (err) {
    console.error('portal/index: data fetch failure', err)
    dashboardError = true
  }
}

// Surface dev-only query override so the error state is reachable in QA.
if (!dashboardError && Astro.url.searchParams.get('state') === 'error') {
  dashboardError = true
}

const nothingOwned = !dashboardError && cards.length === 0

// ---------------------------------------------------------------------------
// Timeline — most recent first, up to 5 entries. Past-tense, concrete events.
// ---------------------------------------------------------------------------

interface TimelineItem {
  ts: string
  date: string
  body: string
  artifactLabel?: string
  artifactHref?: string
  artifactIcon?: string
}

const shortDate = (iso: string): string => {
  const d = new Date(iso)
  if (Number.isNaN(d.getTime())) return ''
  const now = new Date()
  const sameYear = d.getFullYear() === now.getFullYear()
  return d.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    ...(sameYear ? {} : { year: 'numeric' }),
  })
}

const timeline: TimelineItem[] = []

for (const q of quotes) {
  if (q.accepted_at) {
    timeline.push({
      ts: q.accepted_at,
      date: shortDate(q.accepted_at),
      body: 'Proposal signed.',
      artifactLabel: 'Proposal',
      artifactHref: `/portal/engagement/proposals/${q.id}`,
      artifactIcon: 'description',
    })
  } else if (q.sent_at && q.status === 'sent') {
    timeline.push({
      ts: q.sent_at,
      date: shortDate(q.sent_at),
      body: 'Proposal sent for review.',
      artifactLabel: 'Proposal',
      artifactHref: `/portal/engagement/proposals/${q.id}`,
      artifactIcon: 'description',
    })
  }
}

for (const inv of invoices) {
  if (inv.paid_at) {
    timeline.push({
      ts: inv.paid_at,
      date: shortDate(inv.paid_at),
      body: 'Invoice paid.',
      artifactLabel: `Invoice #${inv.id.slice(0, 6)}`,
      artifactHref: `/portal/billing/invoices/${inv.id}`,
      artifactIcon: 'receipt_long',
    })
  } else if (inv.sent_at) {
    timeline.push({
      ts: inv.sent_at,
      date: shortDate(inv.sent_at),
      body: 'Invoice sent.',
      artifactLabel: `Invoice #${inv.id.slice(0, 6)}`,
      artifactHref: `/portal/billing/invoices/${inv.id}`,
      artifactIcon: 'receipt_long',
    })
  }
}

for (const m of completedMilestones) {
  if (!m.completed_at) continue
  timeline.push({
    ts: m.completed_at,
    date: shortDate(m.completed_at),
    body: m.name,
  })
}

timeline.sort((a, b) => (a.ts < b.ts ? 1 : -1))
const timelineEntries = timeline.slice(0, 5)

// Only render a check-in line when an authored touchpoint exists — never
// synthesized outreach copy (no-fabricated-content policy).
const touchpointText: string | null = (() => {
  if (!activeEngagement?.next_touchpoint_label && !activeEngagement?.next_touchpoint_at) {
    return null
  }
  if (activeEngagement.next_touchpoint_label) return activeEngagement.next_touchpoint_label
  const d = new Date(activeEngagement.next_touchpoint_at ?? '')
  if (Number.isNaN(d.getTime())) return null
  return d.toLocaleDateString('en-US', {
    weekday: 'long',
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  })
})()
---

<PortalShell
  title="Portal"
  clientName={client.name}
  orgId={user.org_id}
  entityId={client.id}
  pathname={Astro.url.pathname}
  offerings={offerings ?? undefined}
>
  <PortalPageHead
    tag={activeEngagement ? 'Engagement in flight' : 'Welcome'}
    h1={client.name}
    meta={touchpointText ? `Next · ${touchpointText}` : null}
  />

  {
    dashboardError && (
      <section
        class="mt-10 border-[3px] border-[color:var(--ss-color-error)] bg-[color:var(--ss-color-background)] p-6 md:p-8"
        aria-live="polite"
      >
        <p class="font-mono text-label uppercase tracking-[0.18em] font-bold text-[color:var(--ss-color-error)]">
          Something broke
        </p>
        <h2 class="mt-2 font-body text-2xl md:text-3xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]">
          We couldn't load your portal.
        </h2>
        <p class="mt-3 text-[color:var(--ss-color-text-secondary)]">
          Give it a moment and try again. If it keeps happening, reach the team using the contacts
          in the header.
        </p>
        <div class="mt-5">
          <a
            href="/portal"
            class="inline-flex items-center min-h-11 border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-primary)] hover:bg-[color:var(--ss-color-primary-hover)] px-5 py-2.5 font-body text-sm font-bold uppercase tracking-[0.08em] text-[color:var(--ss-color-background)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--ss-color-action)] focus-visible:ring-offset-2"
          >
            Retry
          </a>
        </div>
      </section>
    )
  }

  {
    nothingOwned && (
      <section
        class="mt-10 border-[3px] border-[color:var(--ss-color-text-primary)] p-8 md:p-12"
        aria-label="Welcome"
      >
        <p class="font-mono text-label uppercase tracking-[0.18em] font-bold text-[color:var(--ss-color-primary)]">
          Your workspace is ready
        </p>
        <h2 class="mt-3 font-body text-2xl md:text-3xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]">
          Welcome to SMD Services.
        </h2>
        <p class="mt-4 max-w-2xl text-lg text-[color:var(--ss-color-text-secondary)] leading-[1.55]">
          This portal is where your work with us lives: proposals to review, engagement progress,
          documents, and billing all land here as they happen. Nothing is in flight yet. When
          something is, this page shows it first.
        </p>
        <p class="mt-4 font-mono text-label uppercase tracking-[0.14em] text-[color:var(--ss-color-text-secondary)]">
          Questions any time: the contact controls in the header reach a person.
        </p>
      </section>
    )
  }

  {
    !dashboardError && !nothingOwned && (
      <>
        <div class="mt-8 md:mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
          {cards.map((card) => (
            <HomeOfferingCard card={card} />
          ))}
        </div>

        {/* The log records engagement-lifecycle events (proposals sent/signed,
            invoices sent/paid, milestones completed). When nothing has
            happened yet — or the client owns only products that don't feed
            it — the section is absent, not an empty frame (empty-chapter
            rule; Captain finding 2026-07-15: the empty box read as filler,
            and its old copy promised a "next touchpoint" nobody authored). */}
        {timelineEntries.length > 0 && (
          <section class="mt-12 min-w-0">
            <p class="font-mono text-label uppercase tracking-[0.18em] font-bold text-[color:var(--ss-color-text-secondary)]">
              Recent activity
            </p>
            <h2 class="mt-2 font-body text-3xl md:text-4xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]">
              Log
            </h2>

            <div class="mt-6 border-[3px] border-[color:var(--ss-color-text-primary)] bg-[color:var(--ss-color-background)] p-5 md:p-7 space-y-6">
              {timelineEntries.map((entry) => (
                <TimelineEntry
                  date={entry.date}
                  body={entry.body}
                  artifactLabel={entry.artifactLabel}
                  artifactHref={entry.artifactHref}
                  artifactIcon={entry.artifactIcon}
                />
              ))}
            </div>
          </section>
        )}
      </>
    )
  }
</PortalShell>
