---
/**
 * /book/manage — Redirect handler for query-parameter token URLs.
 *
 * The reserve endpoint generates manage URLs as /book/manage?token=xxx.
 * Astro's [token].astro dynamic route only matches /book/manage/xxx.
 * This index page extracts the token from the query string and redirects
 * to the canonical path-based URL.
 */
export const prerender = false
import { GOOGLE_FONTS_URL } from '../../../lib/fonts'
import '../../../styles/global.css'
import SkipToMain from '../../../components/SkipToMain.astro'

const token = Astro.url.searchParams.get('token')
if (token) {
  return Astro.redirect(`/book/manage/${encodeURIComponent(token)}`, 302)
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={GOOGLE_FONTS_URL} rel="stylesheet" />
    <title>Manage Your Booking | SMD Services</title>
  </head>
  <body>
    <SkipToMain />
    <main id="main" role="main" class="flex justify-center px-4 py-20">
      <div class="text-center">
        <h1 class="font-display text-heading text-[color:var(--ss-color-text-primary)]">
          Invalid booking link
        </h1>
        <p class="mt-3 text-[color:var(--ss-color-text-secondary)]">
          No booking token found. Check the link in your confirmation email.
        </p>
        <a
          href="/book"
          class="mt-6 inline-block font-mono text-label font-semibold uppercase tracking-[0.14em] text-[color:var(--ss-color-primary)] underline underline-offset-4 hover:text-[color:var(--ss-color-primary-hover)]"
          >Book a new time</a
        >
      </div>
    </main>
  </body>
</html>
