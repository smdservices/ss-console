---
export const prerender = false

import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import CtaButton from '../components/CtaButton.astro'
import { CATEGORY_NAME, CATEGORY_ARTICLE } from '../lib/category'

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Operator',
  description:
    'A dedicated Operator, built for your business and given a real role. It takes on the recurring work, on its own isolated infrastructure, with the operating memory it builds belonging to you.',
  brand: { '@type': 'Brand', name: 'SMD Services' },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: 'SMD Services' },
  },
}

const roleLenses = [
  {
    title: 'Intake and first response',
    body: 'New inquiries, wherever they land. A dispatcher capturing and routing leads for a home services shop, a new-client intake for a professional practice, a front desk taking reservations. It reads the request, pulls the details that matter, drafts the response in your voice, and books the next step.',
  },
  {
    title: 'Keeping work moving',
    body: 'The follow-ups that slip and the handoffs that stall. It watches the work in flight, spots what did not happen, and nudges the right person or drafts the message. Job scheduling for the trades, matter progress for a practice, shift and inventory coordination for a kitchen.',
  },
  {
    title: 'Recurring client communication',
    body: 'The questions you answer the same way every time. Status updates, scheduling, the routine back-and-forth. Drafts go to a reviewer on your team until you trust the Operator to handle a kind of message on its own.',
  },
]

const industries = [
  { name: 'Law firms', seat: 'Intake and matter coordination', slug: 'law-firm' },
  { name: 'Insurance agencies', seat: 'The service and renewal desk', slug: 'insurance' },
  { name: 'Accounting firms', seat: 'The document chase through busy season', slug: 'accounting' },
  { name: 'Advisory firms', seat: 'Client service and operations', slug: 'ria' },
  { name: 'Mortgage brokers', seat: 'The pipeline through clear-to-close', slug: 'mortgage' },
  { name: 'Veterinary clinics', seat: 'The front desk', slug: 'veterinary' },
  { name: 'Dental practices', seat: 'The front office', slug: 'dental' },
  { name: 'Med spas', seat: 'Booking, membership, and rebooking', slug: 'med-spa' },
  { name: 'Title and escrow', seat: 'The closing desk', slug: 'title' },
  {
    name: 'Property management',
    seat: 'Resident and owner coordination',
    slug: 'property-management',
  },
  { name: 'Marketing agencies', seat: 'Account coordination', slug: 'marketing-agency' },
  { name: 'Home services', seat: 'Answering and booking the call', slug: 'home-services' },
]
---

<Base
  title="Operator | SMD Services"
  description="A dedicated Operator, built for your business and given a real role. It takes on the recurring work, on its own isolated infrastructure, with the operating memory it builds belonging to you. Flat monthly subscription."
>
  <Nav />
  <main id="main" role="main">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />

    <!-- § 01 Hero -->
    <section
      class="relative overflow-hidden bg-[color:var(--ss-color-background)] px-6 pt-24 pb-32"
    >
      <div class="mx-auto max-w-5xl text-center">
        <span
          class="inline-block bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.14em] px-2 py-1 mb-8"
          >§ 01</span
        >
        <h1
          class="mb-8 font-['Archivo'] text-5xl md:text-7xl font-black uppercase leading-[1.05] tracking-[-0.03em] text-[color:var(--ss-color-text-primary)]"
        >
          Hire Once.
        </h1>
        <p
          class="mx-auto mb-12 max-w-2xl text-xl leading-relaxed text-[color:var(--ss-color-text-secondary)]"
        >
          A dedicated worker for your business, in its own office and plugged into your systems. It
          takes on the recurring work, learns how you run, and everything it learns stays yours.
        </p>
        <CtaButton href="/book?interest=operator" data-ev="operator-hero-cta"
          >Start the conversation</CtaButton
        >
        <p class="mt-8">
          <a
            href="/why"
            data-ev="operator-hero-why"
            class="inline-flex items-center gap-2 font-['Archivo_Narrow'] text-sm font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-text-secondary)] hover:text-[color:var(--ss-color-text-primary)]"
          >
            <span>New here? Read the case for {CATEGORY_ARTICLE} {CATEGORY_NAME}</span>
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>

    <!-- § 02 The real comparison (the anchor) -->
    <section class="bg-white px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <span
          class="inline-block bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.14em] px-2 py-1 mb-4"
          >§ 02</span
        >
        <h2
          class="mb-10 font-['Archivo'] text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          The Real Comparison.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            The honest comparison is not against other software. It is against hiring a person for
            this work: a coordinator, a dispatcher, an intake lead, someone to own the connective
            work that holds the day together.
          </p>
          <p>
            A new hire learns your business by living inside it, which takes months, and you pay
            full salary for partial value the whole time. The day they leave, what they learned
            walks out with them.
          </p>
          <p>
            An Operator is built for that work instead of hired into it. It connects to the tools
            you already use, it works the way you run, and what it learns stays with the business,
            not in any one person's head.
          </p>
        </div>
      </div>
    </section>

    <!-- § 03 A worker, in another office -->
    <section class="bg-[color:var(--ss-color-background)] px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <span
          class="inline-block bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.14em] px-2 py-1 mb-4"
          >§ 03</span
        >
        <h2
          class="mb-10 font-['Archivo'] text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          A Worker, In Another Office.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            Picture a remote worker from the future, sitting at a desk in your business today. A
            computer, a phone, and access to the systems and processes you already run. You hand it
            work the way you hand work to anyone on your team. You send the request, it does the
            job, and it comes back with the result.
          </p>
          <p>
            It works from its own office, the way much of your team already does. The bookkeeper you
            have never met in person. The vendor you email and trade work with every day. This is
            one more of those.
          </p>
          <p>
            What it takes on is the work you would want that role doing, inside the limits you set.
            We get to those limits below.
          </p>
        </div>
      </div>
    </section>

    <!-- § 04 What you actually get -->
    <section class="bg-white px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <span
          class="inline-block bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.14em] px-2 py-1 mb-4"
          >§ 04</span
        >
        <h2
          class="mb-10 font-['Archivo'] text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          What You Actually Get.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            You get an Operator, not a tool. We build one for your business, give it a role, and set
            it up in the tools your team already uses.
          </p>
          <p>
            Before it starts, we sit down with you and the people who run the work, and we build it
            around how you operate, so it shows up ready, not green. From there it keeps getting
            sharper, learning from your team's corrections.
          </p>
          <p>
            Say you give it intake. It reads a new inquiry, pulls the details that matter, drafts
            the first reply in your voice, books the call, and logs it where your team can see. The
            work moves the way it always did. The person doing it changed.
          </p>
          <p>
            One dedicated Operator, scoped to a role, picking up the recurring work that fills your
            team's day so they have the room to do the work only they can do.
          </p>
        </div>
      </div>
    </section>

    <!-- § 05 One Operator, one memory, all yours -->
    <section class="bg-[color:var(--ss-color-background)] px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <span
          class="inline-block bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.14em] px-2 py-1 mb-4"
          >§ 05</span
        >
        <h2
          class="mb-10 font-['Archivo'] text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          One Operator, One Memory. All Yours.
        </h2>
        <div
          class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)] mb-12"
        >
          <p>
            One Operator for your whole team, not a separate assistant for each person. Everyone
            works with the same Operator, and it gets sharper from everyone's input.
          </p>
          <p>
            The understanding it builds (your voice, your work patterns, the situations it has
            learned to handle) is a record you can read and correct. It belongs to the business, not
            to any one person's account or laptop. When someone moves on, what the Operator knows
            about how you run does not go with them. It stays.
          </p>
          <p>
            The technology underneath keeps improving, and your Operator rides on top of it. You
            hired the Operator, not a version of a tool you have to keep replacing. The memory it
            builds is yours to keep, and it is not locked inside our system.
          </p>
        </div>
        <div class="text-center">
          <CtaButton
            variant="secondary"
            href="/book?interest=operator"
            data-ev="operator-section-cta">Talk through the fit</CtaButton
          >
        </div>
      </div>
    </section>

    <!-- § 06 You set the limits, we keep it running -->
    <section class="bg-white px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <span
          class="inline-block bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.14em] px-2 py-1 mb-4"
          >§ 06</span
        >
        <h2
          class="mb-10 font-['Archivo'] text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          You Set The Limits. We Keep It Running.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            You decide what the Operator can do on its own and what waits for a person to approve.
            That decision is in writing, it is part of the service agreement, and you can change it
            whenever you want.
          </p>
          <p>
            It starts by watching. We sit it next to the work, let it learn how your team handles
            real situations, and check its judgment against yours. When you sign off on a kind of
            work, it takes that over. Until then, its drafts go to a reviewer on your team, who
            sends them. The Operator cannot give itself more authority. Only you can. Every action
            it takes is recorded where you can see it: what it did, when, and why.
          </p>
          <p>
            Your data stays yours. The Operator runs on its own isolated infrastructure, on your own
            accounts. We watch that it is healthy and we can see the record of what it did, but we
            do not see what is inside your files and messages. The configuration, the logs, and the
            off switch stay with you.
          </p>
          <p>
            And keeping it running is our job, not yours. We wire it into your tools, we watch that
            it stays working, and we stay accountable for it. You are giving feedback to an
            Operator, not taking on a second job managing one.
          </p>
        </div>
      </div>
    </section>

    <!-- § 07 A team, not a tool -->
    <section class="bg-[color:var(--ss-color-background)] px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <span
          class="inline-block bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.14em] px-2 py-1 mb-4"
          >§ 07</span
        >
        <h2
          class="mb-10 font-['Archivo'] text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          A Team, Not A Tool.
        </h2>
        <div class="space-y-8 text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]">
          <p>
            We are the team behind the worker. We build it for your business, and we stay
            accountable for how it runs. That work is ours, not yours.
          </p>
          <p>
            The technology moves, and we move with it. No one has ten years of experience with this,
            because it has not been around for ten years. So it is not something you set up once and
            are left to run on your own.
          </p>
          <p>
            This is a service, not a download. We are the team that keeps your business working, and
            nobody should take on something this new alone.
          </p>
        </div>
      </div>
    </section>

    <!-- § 08 Where it fits -->
    <section class="bg-white px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <span
          class="inline-block bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.14em] px-2 py-1 mb-4"
          >§ 08</span
        >
        <h2
          class="mb-6 font-['Archivo'] text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          Where It Fits.
        </h2>
        <p
          class="mb-12 max-w-2xl text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]"
        >
          A few shapes the role can take. We build it around your operation, so these are starting
          points, not a menu.
        </p>

        <div
          class="grid grid-cols-1 md:grid-cols-3 gap-0 border-t-[3px] border-[color:var(--ss-color-text-primary)]"
        >
          {
            roleLenses.map((lens, i) => (
              <div
                class:list={[
                  'flex flex-col gap-4 p-8 min-h-[16rem] border-b-[3px] border-[color:var(--ss-color-text-primary)]',
                  i % 3 !== 2 && 'md:border-r-[3px] md:border-[color:var(--ss-color-text-primary)]',
                ]}
              >
                <p class="font-['Archivo_Narrow'] text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--ss-color-primary)]">
                  {lens.title}
                </p>
                <p class="font-['Archivo'] text-base leading-relaxed text-[color:var(--ss-color-text-secondary)]">
                  {lens.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- § 09 Built for your industry -->
    <section id="industries" class="bg-[color:var(--ss-color-background)] px-6 py-24 scroll-mt-20">
      <div class="mx-auto max-w-5xl">
        <span
          class="inline-block bg-[color:var(--ss-color-text-primary)] text-[color:var(--ss-color-background)] font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.14em] px-2 py-1 mb-4"
          >§ 09</span
        >
        <h2
          class="mb-6 font-['Archivo'] text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-[color:var(--ss-color-text-primary)]"
        >
          Built For Your Industry.
        </h2>
        <p
          class="mb-12 max-w-2xl text-lg leading-relaxed text-[color:var(--ss-color-text-secondary)]"
        >
          The role is built around your operation. For these, we have already mapped the seat the
          Operator fills, the work it takes on, and the line it does not cross. Find yours.
        </p>

        <div
          class="grid grid-cols-1 md:grid-cols-3 gap-0 border-t-[3px] border-[color:var(--ss-color-text-primary)]"
        >
          {
            industries.map((industry, i) => (
              <a
                href={`/packs/${industry.slug}`}
                data-ev={`operator-industry-${industry.slug}`}
                class:list={[
                  'group flex flex-col gap-2 p-8 min-h-[10rem] border-b-[3px] border-[color:var(--ss-color-text-primary)] transition-colors hover:bg-white',
                  i % 3 !== 2 && 'md:border-r-[3px] md:border-[color:var(--ss-color-text-primary)]',
                ]}
              >
                <p class="font-['Archivo'] text-lg font-black uppercase tracking-[-0.01em] text-[color:var(--ss-color-text-primary)] group-hover:text-[color:var(--ss-color-primary)]">
                  {industry.name}
                </p>
                <p class="font-['Archivo'] text-base leading-relaxed text-[color:var(--ss-color-text-secondary)]">
                  {industry.seat}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- § 10 Start the conversation -->
    <section class="bg-[color:var(--ss-color-surface-inverse)] px-6 py-24">
      <div class="mx-auto max-w-5xl text-center">
        <span
          class="inline-block bg-[color:var(--ss-color-background)] text-[color:var(--ss-color-text-primary)] font-['JetBrains_Mono'] text-xs font-semibold uppercase tracking-[0.14em] px-2 py-1 mb-8"
          >§ 10</span
        >
        <h2
          class="mb-6 font-['Archivo'] text-4xl md:text-5xl font-black uppercase tracking-[-0.02em] text-white"
        >
          Start The Conversation.
        </h2>
        <p class="mx-auto mb-6 max-w-2xl text-lg text-[color:var(--ss-color-text-muted)]">
          It starts with a conversation. We learn how your operation runs, find the work that is
          eating your team's time, and figure out where a dedicated Operator fits. If the fit is not
          right, we say so.
        </p>
        <p class="mx-auto mb-10 max-w-2xl text-lg text-[color:var(--ss-color-text-muted)]">
          Pricing is a flat monthly subscription, scoped to the role we build together, and we walk
          through it before any setup begins. No hourly billing, no usage meter, no surprise line
          items.
        </p>
        <CtaButton
          variant="outline-white"
          href="/book?interest=operator"
          data-ev="operator-final-cta">Start the conversation</CtaButton
        >
      </div>
    </section>
  </main>
  <Footer />
</Base>
