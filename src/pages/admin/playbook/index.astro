---
/**
 * Venture Handbook — landing.
 *
 * The franchise operations manual (E-Myth): how to run, build, and grow SMD
 * Services from zero context. This index renders the full table of contents
 * grouped by section; each page is a markdown file under docs/handbook/,
 * rendered by [...slug].astro. Source of truth is the markdown, kept current
 * as a byproduct of building the venture (see docs/handbook/README.md).
 *
 * Admin-only; the explicit guard matches every other admin page.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro'
import HandbookSidebar from './_HandbookSidebar.astro'
import { getCollection } from 'astro:content'

const session = Astro.locals.session!
if (session.role !== 'admin') {
  return Astro.redirect('/auth/sign-in')
}

const SECTIONS: { key: string; label: string; blurb: string }[] = [
  {
    key: 'business',
    label: 'The Business',
    blurb: 'What it is, why it exists, where it is going.',
  },
  { key: 'product', label: 'The Product', blurb: 'What we sell and build.' },
  {
    key: 'system',
    label: 'The System',
    blurb: 'Where everything lives — the code and infrastructure map.',
  },
  {
    key: 'operations',
    label: 'How We Work',
    blurb: 'The operating model, delivery, deployment, and recovery.',
  },
  { key: 'reference', label: 'Reference', blurb: 'Indexes, glossary, and the map of the docs.' },
]

const entries = await getCollection('handbook')
const grouped = SECTIONS.map((s) => ({
  ...s,
  items: entries
    .filter((e) => e.data.section === s.key)
    .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)),
})).filter((g) => g.items.length > 0)

const pageCount = entries.length

const SEC =
  "font-['Archivo_Narrow'] text-[12px] font-bold uppercase tracking-[0.16em] text-[color:var(--ss-color-text-primary)]"
const BODY = 'text-sm leading-relaxed text-[color:var(--ss-color-text-secondary)]'
---

<AdminLayout title="Handbook | SMD Services" maxWidth="max-w-6xl">
  <div class="grid grid-cols-1 gap-8 md:grid-cols-[220px_1fr]">
    <aside
      class="md:sticky md:top-20 md:self-start md:max-h-[calc(100vh-6rem)] md:overflow-y-auto md:overscroll-contain md:pr-2"
    >
      <HandbookSidebar />
    </aside>

    <div class="min-w-0">
      <header class="mb-7 border-b border-[color:var(--ss-color-border)] pb-5">
        <h1 class="text-3xl font-bold text-[color:var(--ss-color-text-primary)]">
          Venture Handbook
        </h1>
        <p class={`mt-2 max-w-2xl text-base leading-relaxed ${BODY}`}>
          The franchise operations manual. Everything a newcomer with zero context needs to run this
          venture, keep building it, and succeed: what it is, why it exists, how it works, and where
          everything lives. The source of truth is markdown in the repo, kept accurate as the
          venture is built.
        </p>
      </header>

      <div class="space-y-7">
        {
          grouped.map((g) => (
            <section class="border border-[color:var(--ss-color-text-primary)]">
              <div class="flex items-baseline justify-between border-b border-[color:var(--ss-color-text-primary)] px-[18px] py-3">
                <span class={SEC}>{g.label}</span>
                <span class="font-['JetBrains_Mono'] text-[11px] text-[color:var(--ss-color-text-muted)]">
                  {g.blurb}
                </span>
              </div>
              <ul>
                {g.items.map((it, i) => (
                  <li
                    class:list={[i > 0 && 'border-t border-[color:var(--ss-color-border-subtle)]']}
                  >
                    <a
                      href={`/admin/playbook/${it.id}`}
                      class="grid grid-cols-1 gap-1 px-[18px] py-3 hover:bg-[color:var(--ss-color-border-subtle)] sm:grid-cols-[200px_1fr] sm:gap-4"
                    >
                      <span class="text-sm font-bold text-[color:var(--ss-color-text-primary)]">
                        {it.data.title}
                      </span>
                      <span class={BODY}>{it.data.summary ?? ''}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      {
        pageCount === 0 && (
          <p class={BODY}>
            No handbook pages found. Add markdown under{' '}
            <code class="font-['JetBrains_Mono'] text-[color:var(--ss-color-text-primary)]">
              docs/handbook/
            </code>
            .
          </p>
        )
      }
    </div>
  </div>
</AdminLayout>
