---
import '../../styles/global.css'
import { verifyMagicLink } from '../../lib/auth/magic-link'
import { asUserRole, createSession, buildSessionCookie } from '../../lib/auth/session'
import { getMagicLinkClientUser, recordUserLogin } from '../../lib/auth/magic-link-users'
import { getPortalBaseUrl } from '../../lib/config/app-url'
import { env } from 'cloudflare:workers'

/**
 * Magic link verification page — GET /auth/verify?token=...
 *
 * When a client clicks their magic link, this page:
 *   1. Validates the token (exists, not expired, not used)
 *   2. Looks up the bound user by id + org
 *   3. Creates a session (30-day expiry)
 *   4. Redirects to /portal with session cookie set
 *
 * On failure, redirects to portal login with an error message.
 *
 * Admin users do NOT enter through this page — admin login is at
 * /auth/login on admin.smd.services.
 */

const token = Astro.url.searchParams.get('token')

if (!token) {
  return Astro.redirect('/auth/sign-in?error=invalid')
}

// Verify and atomically consume the magic link token
const verified = await verifyMagicLink(env.DB, token)

if (!verified) {
  // Token is invalid, expired, or already used
  return Astro.redirect('/auth/sign-in?error=invalid')
}

const user = await getMagicLinkClientUser(env.DB, verified.orgId, verified.userId)

if (!user) {
  return Astro.redirect('/auth/sign-in?error=no_account')
}

await recordUserLogin(env.DB, user)

const sessionToken = await createSession(env.DB, env.SESSIONS, {
  id: user.id,
  orgId: user.org_id,
  role: asUserRole(user.role),
  email: user.email,
})
const location = (() => {
  const portalBaseUrl = getPortalBaseUrl(env)
  return portalBaseUrl ? `${portalBaseUrl}/` : '/portal'
})()
const setCookie = buildSessionCookie(sessionToken, user.role)
const response = new Response(null, { status: 302 })
response.headers.set('Location', location)
response.headers.set('Set-Cookie', setCookie)

// Prevent the middleware's sliding-window refresh from appending a second
// Set-Cookie with the OLD inbound session cookie. If the client clicked
// this magic link from a browser where another session was already
// active, the stale cookie would otherwise win. Nulling Astro.locals.session
// here makes the middleware skip the refresh block; the only Set-Cookie
// on the response is the new session.
Astro.locals.session = null

return response
---
