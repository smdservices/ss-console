---
/**
 * /assessment — internal dogfood surface for the VOICE assessment flow.
 *
 * Gated behind ENABLE_ASSESSMENT_PREVIEW (same idiom as /patterns):
 * 404 unless the flag is set. 2026-06-12 code review found this page
 * publicly reachable while self-describing as "internal dogfood, not yet
 * public". Set the flag in the environment(s) where dogfooding happens.
 */
export const prerender = false

import { env } from 'cloudflare:workers'
import Base from '../layouts/Base.astro'

const flagValue = (env as { ENABLE_ASSESSMENT_PREVIEW?: string }).ENABLE_ASSESSMENT_PREVIEW
const enabled = flagValue === '1' || flagValue === 'true'

if (!enabled) {
  return new Response(null, { status: 404 })
}
---

<Base title="Assessment preview | SMD Services" disableAnalytics={true}>
  <main class="wrap">
    <p class="preview-flag">Preview: internal dogfood, not yet public</p>

    <header class="head">
      <h1>A quick read on how your business runs</h1>
      <p class="sub">
        A short conversation about how your operation works day to day. At the end you'll get a
        clear picture of what's working and where things strain.
      </p>
    </header>

    <div id="intro" class="intro">
      <p>
        It's a real conversation, not a form. Talk the way you'd talk to a colleague who's trying to
        understand your business. When we're done, you'll see the findings.
      </p>
      <div class="intro-actions">
        <button id="start-voice" class="btn" type="button">Talk to it</button>
        <button id="start-btn" class="btn btn-ghost" type="button">Or type instead</button>
      </div>
    </div>

    <div id="chat" class="chat" hidden></div>

    <div id="voice-controls" class="voice-controls" hidden aria-live="polite">
      <span id="voice-status" class="voice-status">Connecting…</span>
      <button id="voice-end" class="btn" type="button">End &amp; see findings</button>
    </div>

    <div id="thinking" class="thinking" hidden aria-live="polite">
      <span></span><span></span><span></span>
    </div>

    <form id="composer" class="composer" hidden>
      <textarea
        id="owner-input"
        rows="2"
        placeholder="Type your reply… (Enter to send, Shift+Enter for a new line)"
        autocomplete="off"></textarea>
      <button id="send-btn" class="btn" type="submit">Send</button>
    </form>

    <section id="report" class="report" hidden aria-live="polite">
      <h2 class="report-title">Your assessment findings</h2>
      <p class="report-note">
        A working draft from the conversation. What matters most, and what to do about it, is what
        we'd walk through together on a call.
      </p>
      <div id="report-body" class="report-body"></div>
    </section>
  </main>

  <script>
    import '../scripts/assessment.ts'
  </script>
  <script>
    import '../scripts/assessment-voice.ts'
  </script>
</Base>

<style>
  .wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.25rem 5rem;
    font-family: var(--ss-font-body);
    color: #1a1a1a;
  }
  .preview-flag {
    font-family: var(--ss-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #8a6d00;
    background: #fff7e0;
    border: 1px solid #f0e0a8;
    border-radius: 4px;
    padding: 0.3rem 0.6rem;
    display: inline-block;
    margin-bottom: 1.5rem;
  }
  .head h1 {
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 0.6rem;
  }
  .sub {
    color: #555;
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0 0 1.5rem;
  }
  .intro {
    border: 1px solid #e6e6e6;
    border-radius: 10px;
    padding: 1.5rem;
    background: #fafafa;
  }
  .intro p {
    margin: 0 0 1.2rem;
    color: #444;
    line-height: 1.55;
  }
  .intro-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .btn-ghost {
    background: transparent;
    color: #1a1a1a;
    border: 1px solid #d8d8d8;
    font-weight: 500;
  }
  .btn-ghost:hover {
    background: #f0f0f0;
  }
  .voice-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 1rem 0;
    padding: 0.85rem 1rem;
    border: 1px solid #e6e6e6;
    border-radius: 10px;
    background: #fafafa;
    position: sticky;
    bottom: 0;
  }
  .voice-status {
    font-size: 0.95rem;
    color: #555;
  }
  .btn {
    appearance: none;
    border: none;
    background: #1a1a1a;
    color: #fff;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.7rem 1.4rem;
    border-radius: 8px;
    cursor: pointer;
  }
  .btn:hover {
    background: #333;
  }
  .btn:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .chat {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1rem 0;
  }
  .bubble {
    max-width: 88%;
  }
  .bubble-operator {
    align-self: flex-start;
  }
  .bubble-owner {
    align-self: flex-end;
    text-align: right;
  }
  .bubble-who {
    font-family: var(--ss-font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #999;
    margin-bottom: 0.25rem;
  }
  .bubble-text {
    display: inline-block;
    text-align: left;
    white-space: pre-wrap;
    line-height: 1.5;
    padding: 0.75rem 1rem;
    border-radius: 12px;
  }
  .bubble-operator .bubble-text {
    background: #f0f1f3;
    color: #1a1a1a;
    border-bottom-left-radius: 3px;
  }
  .bubble-owner .bubble-text {
    background: #1a1a1a;
    color: #fff;
    border-bottom-right-radius: 3px;
  }
  .thinking {
    display: flex;
    gap: 4px;
    padding: 0.5rem 0.25rem;
  }
  .thinking span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #bbb;
    animation: blink 1.2s infinite both;
  }
  .thinking span:nth-child(2) {
    animation-delay: 0.2s;
  }
  .thinking span:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes blink {
    0%,
    80%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }
  .composer {
    display: flex;
    gap: 0.6rem;
    align-items: flex-end;
    margin-top: 0.5rem;
    position: sticky;
    bottom: 0;
    background: #fff;
    padding-top: 0.5rem;
  }
  .composer textarea {
    flex: 1;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.45;
    padding: 0.65rem 0.8rem;
    border: 1px solid #d8d8d8;
    border-radius: 8px;
    resize: vertical;
  }
  .composer textarea:disabled {
    background: #f5f5f5;
  }
  .report {
    margin-top: 2.5rem;
    border-top: 2px solid #1a1a1a;
    padding-top: 1.5rem;
  }
  .report-title {
    font-size: 1.5rem;
    margin: 0 0 0.4rem;
  }
  .report-note {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0 0 1.5rem;
  }
  .report-body :global(h2) {
    font-size: 1.5rem;
    margin: 1.5rem 0 0.5rem;
  }
  .report-body :global(h3) {
    font-size: 1.15rem;
    margin: 1.75rem 0 0.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid #eee;
  }
  .report-body :global(h4) {
    font-size: 1rem;
    margin: 1.25rem 0 0.4rem;
    color: #333;
  }
  .report-body :global(p) {
    line-height: 1.6;
    margin: 0.5rem 0;
  }
  .report-body :global(ul) {
    margin: 0.5rem 0;
    padding-left: 1.2rem;
  }
  .report-body :global(li) {
    margin: 0.6rem 0;
    line-height: 1.5;
  }
  .report-body :global(blockquote) {
    margin: 0.3rem 0 0.8rem;
    padding: 0.4rem 0 0.4rem 1rem;
    border-left: 3px solid #d8d8d8;
    color: #555;
    font-style: italic;
  }
  .muted {
    color: #888;
  }
</style>
